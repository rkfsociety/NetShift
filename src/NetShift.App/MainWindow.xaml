<Window x:Class="NetShift.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="NetShift" Icon="Assets/NetShift.ico" Width="1440" Height="920" MinWidth="1120" MinHeight="760"
        WindowStartupLocation="CenterScreen" WindowStyle="None" ResizeMode="CanResize"
        Background="{StaticResource CanvasBrush}" Foreground="{StaticResource TextBrush}"
        StateChanged="MainWindow_StateChanged">
  <shell:WindowChrome.WindowChrome>
    <shell:WindowChrome CaptionHeight="42" ResizeBorderThickness="6" GlassFrameThickness="0"
                        CornerRadius="0" UseAeroCaptionButtons="False" />
  </shell:WindowChrome.WindowChrome>
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="42" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>
    <Border Grid.RowSpan="2" Background="{StaticResource CanvasBrush}"
            BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" />

    <Grid Grid.Row="0" Background="#08111E" Panel.ZIndex="1">
      <DockPanel LastChildFill="False">
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0">
          <Image Source="Assets/NetShift.ico" Width="18" Height="18" Stretch="Uniform" />
          <TextBlock Text="NetShift" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" Margin="9,0,0,0" />
        </StackPanel>
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
          <Button Style="{StaticResource WindowControlButtonStyle}" shell:WindowChrome.IsHitTestVisibleInChrome="True"
                  Click="MinimizeWindow_Click" ToolTip="Свернуть">
            <TextBlock Text="&#xE921;" FontFamily="Segoe MDL2 Assets" FontSize="10" />
          </Button>
          <Button x:Name="MaximizeWindowButton" Style="{StaticResource WindowControlButtonStyle}"
                  shell:WindowChrome.IsHitTestVisibleInChrome="True" Click="ToggleMaximizeWindow_Click" ToolTip="Развернуть">
            <TextBlock x:Name="MaximizeWindowGlyph" Text="&#xE922;" FontFamily="Segoe MDL2 Assets" FontSize="10" />
          </Button>
          <Button Style="{StaticResource WindowCloseButtonStyle}" shell:WindowChrome.IsHitTestVisibleInChrome="True"
                  Click="CloseWindow_Click" ToolTip="Закрыть">
            <TextBlock Text="&#xE8BB;" FontFamily="Segoe MDL2 Assets" FontSize="12" />
          </Button>
        </StackPanel>
      </DockPanel>
    </Grid>

    <Grid Grid.Row="1">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="272" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>

      <Border Grid.Column="0" Background="{StaticResource SidebarBrush}" BorderBrush="{StaticResource BorderBrush}"
              BorderThickness="0,0,1,0" Padding="20,28,18,20">
        <DockPanel LastChildFill="True">
          <StackPanel DockPanel.Dock="Top">
            <StackPanel Orientation="Horizontal" Margin="0,0,0,42">
              <Border Width="58" Height="58" CornerRadius="15" Background="{StaticResource LogoBrush}"
                      BorderBrush="#14B8E8" BorderThickness="1">
                <TextBlock Text="N" Foreground="White" FontSize="34" FontWeight="Bold"
                           HorizontalAlignment="Center" VerticalAlignment="Center" />
              </Border>
              <StackPanel VerticalAlignment="Center" Margin="14,0,0,0">
                <TextBlock Text="NetShift" FontSize="29" FontWeight="Bold" />
                <TextBlock Text="Сеть под контролем" Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="1,1,0,0" />
              </StackPanel>
            </StackPanel>
            <Button x:Name="DnsNavigationButton" Tag="dns" Click="NavigatePage_Click"
                    Style="{StaticResource NavigationButtonStyle}" Background="{StaticResource NavSelectedBrush}"
                    BorderBrush="#1787F5" Foreground="White">
              <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE774;" FontFamily="Segoe MDL2 Assets" FontSize="24" Foreground="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}" Margin="0,0,16,0"/><TextBlock Text="DNS" Foreground="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}" VerticalAlignment="Center"/></StackPanel>
            </Button>
            <Button x:Name="ZapretNavigationButton" Tag="zapret" Click="NavigatePage_Click"
                    Style="{StaticResource NavigationButtonStyle}" Margin="0,10,0,0"
                    Background="{StaticResource PanelBrush}" BorderBrush="Transparent" Foreground="{StaticResource MutedBrush}">
              <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE711;" FontFamily="Segoe MDL2 Assets" FontSize="24" Foreground="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}" Margin="0,0,16,0"/><TextBlock Text="zapret" Foreground="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}" VerticalAlignment="Center"/></StackPanel>
            </Button>
          </StackPanel>
          <StackPanel DockPanel.Dock="Bottom" Margin="0,0,0,2">
            <Border Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                    CornerRadius="12" Padding="12" Margin="0,0,0,12">
              <StackPanel>
                <Grid>
                  <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                  <Ellipse x:Name="DnsServiceIndicator" Width="11" Height="11" Fill="#718096" Margin="0,3,9,0" />
                  <StackPanel Grid.Column="1">
                    <TextBlock Text="Служба DNS" FontSize="14" FontWeight="SemiBold" />
                    <TextBlock x:Name="DnsServiceStatusText" Text="Проверка состояния…" Foreground="{StaticResource MutedBrush}"
                               FontSize="12" TextWrapping="Wrap" />
                  </StackPanel>
                </Grid>
                <Button Content="Обновить статус" Click="RefreshDnsServiceStatus_Click" Padding="10,6" MinHeight="36" Margin="0,9,0,0" />
                <Button x:Name="UpdateButton" Content="Проверить обновления" Click="UpdateButton_Click"
                        Padding="10,6" MinHeight="38" Margin="0,7,0,0" />
                <Button x:Name="InstallDnsServiceButton" Content="Установить службу DNS" Click="InstallDnsService_Click"
                        Visibility="Collapsed" Padding="10,5" MinHeight="34" Margin="0,7,0,0" />
                <Button x:Name="RemoveDnsServiceButton" Content="Удалить службу" Click="RemoveDnsService_Click"
                        Padding="10,6" MinHeight="36" Margin="0,7,0,0" />
                <TextBlock x:Name="UpdateStatusText" Text="Проверка обновлений…" Foreground="{StaticResource MutedBrush}"
                           FontSize="11" TextWrapping="Wrap" Margin="0,7,0,0" />
              </StackPanel>
            </Border>
            <Border Height="1" Background="{StaticResource BorderBrush}" Margin="0,0,0,10" />
            <Button x:Name="SettingsNavigationButton" Tag="settings" Click="NavigatePage_Click"
                    Style="{StaticResource NavigationButtonStyle}" MinHeight="58" Padding="18,12"
                    Background="Transparent" Foreground="{StaticResource MutedBrush}" BorderBrush="Transparent">
              <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE713;" FontFamily="Segoe MDL2 Assets" FontSize="21" Foreground="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}" Margin="0,0,14,0"/><TextBlock Text="Настройки" Foreground="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}" VerticalAlignment="Center" FontSize="15"/></StackPanel>
            </Button>
            <Button x:Name="AboutNavigationButton" Tag="about" Click="NavigatePage_Click"
                    Style="{StaticResource NavigationButtonStyle}" MinHeight="58" Padding="18,12" Margin="0,5,0,0"
                    Background="Transparent" Foreground="{StaticResource MutedBrush}" BorderBrush="Transparent">
              <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE946;" FontFamily="Segoe MDL2 Assets" FontSize="21" Foreground="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}" Margin="0,0,14,0"/><TextBlock Text="О программе" Foreground="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}" VerticalAlignment="Center" FontSize="15"/></StackPanel>
            </Button>
            <Border Height="1" Background="{StaticResource BorderBrush}" Margin="0,14,0,14" />
            <TextBlock Text="Системные действия подтверждаются Windows."
                       Foreground="{StaticResource MutedBrush}" FontSize="11" TextWrapping="Wrap" Margin="2,18,2,0" />
          </StackPanel>
        </DockPanel>
      </Border>

      <Grid Grid.Column="1">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid Grid.Row="0" Margin="28,14,28,12">
          <TextBlock x:Name="PageTitleText" Text="DNS" FontSize="36" FontWeight="Bold" VerticalAlignment="Center" />
        </Grid>

      <Grid Grid.Row="1">
        <ScrollViewer x:Name="DnsPage" VerticalScrollBarVisibility="Auto" Padding="28,0,28,24">
          <StackPanel>
            <Border Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="18" Padding="30">
              <StackPanel>
                <Grid>
                  <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="34"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                  <StackPanel>
                    <DockPanel LastChildFill="False" Margin="0,0,0,10">
                      <TextBlock Text="Адаптер" FontSize="19" FontWeight="SemiBold" VerticalAlignment="Center" />
                      <Button Content="Обновить список" Click="RefreshAdapters_Click" DockPanel.Dock="Right" Padding="10,5" MinHeight="34" />
                    </DockPanel>
                    <ComboBox x:Name="AdapterComboBox" SelectionChanged="AdapterComboBox_SelectionChanged" MinHeight="52" FontSize="16" />
                    <TextBlock x:Name="CurrentDnsText" Text="Текущие DNS: загрузка…" Foreground="{StaticResource MutedBrush}" FontSize="12" TextWrapping="Wrap" Margin="4,8,0,0" />
                  </StackPanel>
                  <Border Grid.Column="1" Width="1" Background="{StaticResource BorderBrush}" HorizontalAlignment="Center" Margin="0,4" />
                  <StackPanel Grid.Column="2">
                    <DockPanel LastChildFill="False" Margin="0,0,0,10">
                      <TextBlock Text="Провайдер" FontSize="19" FontWeight="SemiBold" VerticalAlignment="Center" />
                      <Button x:Name="RefreshDnsAiButton" Content="Обновить DNS-AI" Click="RefreshDnsAi_Click" DockPanel.Dock="Right" Padding="10,5" MinHeight="34" />
                    </DockPanel>
                    <ComboBox x:Name="ProviderComboBox" DisplayMemberPath="Name" SelectionChanged="ProviderComboBox_SelectionChanged" MinHeight="52" FontSize="16" />
                    <TextBlock x:Name="DnsProviderStatusText" Text="DNS-AI: загружаются актуальные настройки сайта…"
                               Foreground="{StaticResource MutedBrush}" FontSize="12" TextWrapping="Wrap" Margin="4,8,0,0" />
                  </StackPanel>
                </Grid>

                <Grid Margin="0,28,0,0">
                  <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="34"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                  <StackPanel>
                    <TextBlock Text="DNS IPv4" FontSize="19" FontWeight="SemiBold" Margin="0,0,0,12" />
                    <Grid Margin="0,0,0,10"><Grid.ColumnDefinitions><ColumnDefinition Width="132"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                      <TextBlock Text="Основной" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" />
                      <TextBox x:Name="Ipv4TextBox" Grid.Column="1" ToolTip="Основной IPv4 адрес" MinHeight="52" FontSize="16" />
                    </Grid>
                    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="132"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                      <TextBlock Text="Альтернативный" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" />
                      <TextBox x:Name="Ipv4AlternateTextBox" Grid.Column="1" ToolTip="Дополнительный IPv4 адрес" MinHeight="52" FontSize="16" />
                    </Grid>
                  </StackPanel>
                  <Border Grid.Column="1" Width="1" Background="{StaticResource BorderBrush}" HorizontalAlignment="Center" Margin="0,4" />
                  <StackPanel Grid.Column="2">
                    <TextBlock Text="DNS IPv6" FontSize="19" FontWeight="SemiBold" Margin="0,0,0,12" />
                    <Grid Margin="0,0,0,10"><Grid.ColumnDefinitions><ColumnDefinition Width="132"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                      <TextBlock Text="Основной" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" />
                      <TextBox x:Name="Ipv6TextBox" Grid.Column="1" ToolTip="Основной IPv6 адрес" MinHeight="52" FontSize="16" />
                    </Grid>
                    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="132"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                      <TextBlock Text="Альтернативный" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" />
                      <TextBox x:Name="Ipv6AlternateTextBox" Grid.Column="1" ToolTip="Дополнительный IPv6 адрес" MinHeight="52" FontSize="16" />
                    </Grid>
                  </StackPanel>
                </Grid>

                <TextBlock Text="Режим защиты" FontSize="19" FontWeight="SemiBold" Margin="0,30,0,12" />
                <Grid>
                  <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                  <Border x:Name="LegacyModeCard" CornerRadius="12" Padding="18">
                    <Border.Style><Style TargetType="Border"><Setter Property="Background" Value="{StaticResource PanelBrush}"/><Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/><Setter Property="BorderThickness" Value="1"/><Style.Triggers><DataTrigger Binding="{Binding IsChecked, ElementName=LegacyModeRadio}" Value="True"><Setter Property="Background" Value="{StaticResource AccentDarkBrush}"/><Setter Property="BorderBrush" Value="{StaticResource AccentBrush}"/><Setter Property="BorderThickness" Value="2"/></DataTrigger></Style.Triggers></Style></Border.Style>
                    <RadioButton x:Name="LegacyModeRadio" GroupName="DnsMode" IsChecked="True" Foreground="White">
                      <StackPanel Margin="8,0,0,0"><TextBlock Text="Legacy: локальный прокси" FontSize="17" FontWeight="SemiBold" />
                        <TextBlock Text="Перехват и шифрование DNS через локальный прокси." Foreground="#A9BCD8" FontSize="13" TextWrapping="Wrap" Margin="0,8,0,0" /></StackPanel>
                    </RadioButton>
                  </Border>
                  <Border x:Name="NativeModeCard" Grid.Column="2" CornerRadius="12" Padding="18">
                    <Border.Style><Style TargetType="Border"><Setter Property="Background" Value="{StaticResource PanelBrush}"/><Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/><Setter Property="BorderThickness" Value="1"/><Style.Triggers><DataTrigger Binding="{Binding IsChecked, ElementName=NativeModeRadio}" Value="True"><Setter Property="Background" Value="{StaticResource AccentDarkBrush}"/><Setter Property="BorderBrush" Value="{StaticResource AccentBrush}"/><Setter Property="BorderThickness" Value="2"/></DataTrigger></Style.Triggers></Style></Border.Style>
                    <RadioButton x:Name="NativeModeRadio" GroupName="DnsMode" Foreground="{StaticResource TextBrush}">
                      <StackPanel Margin="8,0,0,0"><TextBlock Text="Native: DNS Windows" FontSize="17" FontWeight="SemiBold" />
                        <TextBlock Text="Использовать системный DNS Windows." Foreground="{StaticResource MutedBrush}" FontSize="13" TextWrapping="Wrap" Margin="0,8,0,0" /></StackPanel>
                    </RadioButton>
                  </Border>
                </Grid>

                <Grid Margin="0,26,0,0">
                  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                  <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                  <StackPanel Orientation="Horizontal" Grid.ColumnSpan="2" Margin="0,0,0,8">
                    <TextBlock Text="Шаблон DoH" FontSize="19" FontWeight="SemiBold" VerticalAlignment="Center" />
                    <CheckBox x:Name="DohEnabledCheckBox" Content="Использовать DoH в Windows" IsChecked="False" Margin="24,0,0,0" VerticalAlignment="Center" />
                  </StackPanel>
                  <TextBox x:Name="DohTemplateTextBox" Grid.Row="1" Grid.ColumnSpan="2" IsEnabled="{Binding IsChecked, ElementName=DohEnabledCheckBox}"
                           ToolTip="Например: https://dns.dns-ai.ru/dns-query" MinHeight="52" FontSize="16" />
                </Grid>
                <WrapPanel Margin="0,18,0,0">
                  <CheckBox x:Name="SupportIPv6CheckBox" Content="Поддержка IPv6" IsChecked="True" Margin="0,0,24,0" VerticalAlignment="Center" />
                  <CheckBox x:Name="ConfigureVpnAdaptersCheckBox" Content="Настраивать DNS для VPN-адаптеров" ToolTip="VPN-адаптеры появятся в списке сетевых адаптеров. DNS меняется только у выбранного подключения." IsChecked="False" Click="ConfigureVpnAdapters_Click" VerticalAlignment="Center" />
                </WrapPanel>
                <Border Height="1" Background="{StaticResource BorderBrush}" Margin="0,22,0,18" />
                <Grid>
                  <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="18"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                  <Button Content="Применить DNS" Background="{StaticResource AccentBrush}" Foreground="#062033"
                          BorderBrush="{StaticResource AccentBrush}" Click="ApplyDns_Click" MinHeight="54" FontSize="17" />
                  <Button Grid.Column="2" Content="Вернуть DHCP" Click="ResetDns_Click" MinHeight="54" FontSize="17" />
                </Grid>
              </StackPanel>
            </Border>
          </StackPanel>
        </ScrollViewer>

        <ScrollViewer x:Name="ZapretPage" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" Padding="28,0,28,24">
          <StackPanel>
            <Border Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="18" Padding="26" Margin="0,0,0,16">
              <StackPanel>
                <Grid Margin="0,0,0,12">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <StackPanel>
                    <TextBlock Text="Пакет zapret" FontSize="17" FontWeight="SemiBold" />
                    <TextBlock Text="Пакет будет загружен и установлен в C:\NetShift."
                               Foreground="{StaticResource MutedBrush}" FontSize="13" TextWrapping="Wrap" Margin="0,4,10,0" />
                  </StackPanel>
                  <Button x:Name="DownloadLatestButton" Grid.Column="1" Content="Скачать последний релиз"
                          Background="{StaticResource AccentBrush}" Foreground="#07151A" BorderBrush="{StaticResource AccentBrush}"
                          Click="DownloadLatest_Click" Padding="14,8" MinHeight="38" />
                </Grid>
                <ProgressBar x:Name="DownloadProgressBar" Height="5" Minimum="0" Maximum="100" Visibility="Collapsed" />
                <TextBlock x:Name="DownloadStatusText" Text="Релиз ещё не проверен" Foreground="{StaticResource MutedBrush}" FontSize="13" Margin="2,8,0,12" />
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <TextBox x:Name="ZapretFolderTextBox" IsReadOnly="True" VerticalContentAlignment="Center" />
                  <Button x:Name="ChooseZapretFolderButton" Grid.Column="1" Content="Выбрать папку" Click="ChooseZapretFolder_Click" Margin="10,0,0,0" />
                </Grid>
                <TextBlock x:Name="ZapretStatusText" Text="Папка zapret не выбрана" Foreground="{StaticResource MutedBrush}" FontSize="13" Margin="2,10,0,0" />
              </StackPanel>
            </Border>

            <Border Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="18" Padding="26">
              <StackPanel>
                <TextBlock Text="Запуск и служба Windows" FontSize="17" FontWeight="SemiBold" />
                <TextBlock Text="Выберите стратегию для запуска или службы Windows."
                           Foreground="{StaticResource MutedBrush}" FontSize="13" TextWrapping="Wrap" Margin="0,4,0,14" />
                <ComboBox x:Name="StrategyComboBox">
                  <ComboBox.ItemTemplate>
                    <DataTemplate>
                      <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{Binding Name}" />
                        <Ellipse Width="8" Height="8" Fill="{Binding HealthBrush}" Visibility="{Binding HealthVisibility}"
                                 Margin="8,0,0,0" VerticalAlignment="Center" ToolTip="{Binding HealthTooltip}">
                          <Ellipse.Style>
                            <Style TargetType="Ellipse">
                              <Style.Triggers>
                                <DataTrigger Binding="{Binding IsRecommended}" Value="True">
                                  <DataTrigger.EnterActions>
                                    <BeginStoryboard x:Name="RecommendedStrategyPulse">
                                      <Storyboard AutoReverse="True" RepeatBehavior="Forever">
                                        <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0.35" To="1" Duration="0:0:0.8" />
                                      </Storyboard>
                                    </BeginStoryboard>
                                  </DataTrigger.EnterActions>
                                  <DataTrigger.ExitActions>
                                    <StopStoryboard BeginStoryboardName="RecommendedStrategyPulse" />
                                  </DataTrigger.ExitActions>
                                </DataTrigger>
                              </Style.Triggers>
                            </Style>
                          </Ellipse.Style>
                        </Ellipse>
                      </StackPanel>
                    </DataTemplate>
                  </ComboBox.ItemTemplate>
                </ComboBox>
                <WrapPanel Margin="0,16,0,0">
                  <Button x:Name="StartStrategyButton" Content="Запустить стратегию" Background="{StaticResource AccentBrush}" Foreground="#07151A"
                          BorderBrush="{StaticResource AccentBrush}" Click="StartStrategy_Click" />
                  <Button x:Name="StopStrategyButton" Content="Остановить ручной запуск" Click="StopStrategy_Click" Margin="8,0,0,0" />
                  <Button x:Name="InstallServiceButton" Content="Установить службу" Click="InstallService_Click" Margin="8,0,0,0" />
                  <Button x:Name="StartServiceButton" Content="Запустить службу" Click="StartService_Click" Margin="8,0,0,0" />
                  <Button x:Name="StopServiceButton" Content="Остановить службу" Click="StopService_Click" Margin="8,0,0,0" />
                  <Button x:Name="RemoveServiceButton" Content="Удалить службу" Click="RemoveService_Click" Margin="8,0,0,0" />
                  <Button Content="Обновить статус" Click="RefreshServiceStatus_Click" Margin="8,0,0,0" />
                </WrapPanel>
                <TextBlock x:Name="ServiceStatusText" Text="Служба zapret: статус не проверен" Foreground="{StaticResource MutedBrush}" FontSize="13" TextWrapping="Wrap" Margin="1,12,0,0" />
                <TextBlock x:Name="ManualStrategyStatusText" Text="Ручной запуск стратегии: статус не проверен" Foreground="{StaticResource MutedBrush}" FontSize="13" TextWrapping="Wrap" Margin="1,5,0,0" />
                <Button x:Name="CheckActiveStrategyButton" Content="Проверить стратегии" Click="CheckActiveStrategy_Click" HorizontalAlignment="Left" Margin="0,10,0,0" />
                <TextBlock x:Name="ZapretHealthStatusText" Text="Проверка стратегий ещё не выполнялась." Foreground="{StaticResource MutedBrush}" FontSize="13" TextWrapping="Wrap" Margin="1,10,0,0" />
                <Border Background="#0D1929" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="10" Padding="12" Margin="0,10,0,0">
                  <StackPanel>
                    <Grid>
                      <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                      <TextBlock Text="Проверка доступности сайтов" FontWeight="SemiBold" />
                      <TextBlock x:Name="ZapretTestPhaseText" Grid.Column="1" Text="Ожидает проверки" Foreground="{StaticResource MutedBrush}" FontWeight="SemiBold" />
                    </Grid>
                    <TextBlock x:Name="ZapretTestStrategyText" Text="При остановленной службе стратегии проверяются по очереди; первая с доступом ко всем сайтам будет рекомендована. Работающую службу NetShift не прерывает." Foreground="{StaticResource MutedBrush}" FontSize="12" TextWrapping="Wrap" Margin="0,5,0,8" />
                    <ProgressBar x:Name="ZapretTestProgressBar" Height="4" IsIndeterminate="True" Visibility="Collapsed" Margin="0,0,0,8" />
                    <UniformGrid Columns="3">
                      <Border Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="7" Padding="9" Margin="0,0,6,0">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                          <Ellipse x:Name="DiscordTestIndicator" Width="9" Height="9" Fill="#718096" Margin="0,0,8,0" />
                          <StackPanel><TextBlock Text="Discord" FontWeight="SemiBold"/><TextBlock x:Name="DiscordTestStatusText" Text="Не проверялся" Foreground="{StaticResource MutedBrush}" FontSize="11" /></StackPanel>
                        </StackPanel>
                      </Border>
                      <Border Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="7" Padding="9" Margin="3,0">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                          <Ellipse x:Name="YouTubeTestIndicator" Width="9" Height="9" Fill="#718096" Margin="0,0,8,0" />
                          <StackPanel><TextBlock Text="YouTube" FontWeight="SemiBold"/><TextBlock x:Name="YouTubeTestStatusText" Text="Не проверялся" Foreground="{StaticResource MutedBrush}" FontSize="11" /></StackPanel>
                        </StackPanel>
                      </Border>
                      <Border Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="7" Padding="9" Margin="6,0,0,0">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                          <Ellipse x:Name="GoogleTestIndicator" Width="9" Height="9" Fill="#718096" Margin="0,0,8,0" />
                          <StackPanel><TextBlock Text="Google" FontWeight="SemiBold"/><TextBlock x:Name="GoogleTestStatusText" Text="Не проверялся" Foreground="{StaticResource MutedBrush}" FontSize="11" /></StackPanel>
                        </StackPanel>
                      </Border>
                    </UniformGrid>
                  </StackPanel>
                </Border>
              </StackPanel>
            </Border>

            <Border Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="16" Padding="20" Margin="0,14,0,0">
              <StackPanel>
                <TextBlock Text="Параметры пакета" FontSize="17" FontWeight="SemiBold" />
                <Grid Margin="0,12,0,0">
                  <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                  </Grid.RowDefinitions>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="120" />
                    <ColumnDefinition Width="180" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="*" />
                  </Grid.ColumnDefinitions>
                  <TextBlock Text="Игровой фильтр" VerticalAlignment="Center" Foreground="{StaticResource MutedBrush}" />
                  <ComboBox x:Name="GameFilterModeComboBox" Grid.Column="1" />
                  <TextBlock Grid.Row="0" Grid.Column="3" Text="TCP порты" VerticalAlignment="Center" Foreground="{StaticResource MutedBrush}" />
                  <TextBox x:Name="GameFilterTcpTextBox" Grid.Row="1" Grid.Column="3" Margin="0,5,0,0" ToolTip="Например: 1024-65535" />
                  <TextBlock Grid.Row="0" Grid.Column="5" Text="UDP порты" VerticalAlignment="Center" Foreground="{StaticResource MutedBrush}" />
                  <TextBox x:Name="GameFilterUdpTextBox" Grid.Row="1" Grid.Column="5" Margin="0,5,0,0" ToolTip="Например: 1024-65535" />
                </Grid>
                <Grid Margin="0,12,0,0">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="120" />
                    <ColumnDefinition Width="180" />
                    <ColumnDefinition Width="20" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                  </Grid.ColumnDefinitions>
                  <TextBlock Text="IPSet-фильтр" VerticalAlignment="Center" Foreground="{StaticResource MutedBrush}" />
                  <ComboBox x:Name="IpSetModeComboBox" Grid.Column="1" />
                  <CheckBox x:Name="AutoUpdateCheckBox" Grid.Column="3" Content="Проверять релиз в NetShift перед запуском" VerticalAlignment="Center" />
                </Grid>
                <WrapPanel Margin="0,14,0,0">
                  <Button x:Name="SavePackageSettingsButton" Content="Сохранить параметры" Click="SavePackageSettings_Click" />
                  <Button x:Name="UpdateIpSetButton" Content="Обновить IPSet" Click="UpdateIpSet_Click" Margin="8,0,0,0" />
                  <Button x:Name="CheckReleaseButton" Content="Проверить новую версию" Click="CheckRelease_Click" Margin="8,0,0,0" />
                </WrapPanel>
              </StackPanel>
            </Border>

            <Border Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="16" Padding="20" Margin="0,14,0,0">
              <StackPanel>
                <TextBlock Text="Инструменты и диагностика" FontSize="17" FontWeight="SemiBold" />
                <Grid Margin="0,12,0,0">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="150" />
                    <ColumnDefinition Width="180" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <ComboBox x:Name="FakeTargetComboBox" Grid.Column="0" />
                  <ComboBox x:Name="FakeFileComboBox" Grid.Column="1" />
                  <TextBlock Grid.Column="3" Text="Замена активного UDP fake-файла" VerticalAlignment="Center" Foreground="{StaticResource MutedBrush}" />
                  <Button x:Name="ReplaceFakeButton" Grid.Column="4" Content="Заменить" Click="ReplaceFake_Click" Margin="8,0,0,0" />
                </Grid>
                <WrapPanel Margin="0,14,0,0">
                  <Button x:Name="RunDiagnosticsButton" Content="Запустить диагностику" Click="RunDiagnostics_Click" />
                  <Button x:Name="RunUpstreamTestsButton" Content="Запустить тесты zapret" Click="RunUpstreamTests_Click" Margin="8,0,0,0" />
                  <Button x:Name="CheckHostsButton" Content="Проверить hosts" Click="CheckHosts_Click" Margin="8,0,0,0" />
                  <Button x:Name="RestoreHostsButton" Content="Восстановить hosts" Click="RestoreHostsBackup_Click" Margin="8,0,0,0" />
                </WrapPanel>
                <TextBox x:Name="ToolsOutputTextBox" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                         MinHeight="70" MaxHeight="150" Margin="0,12,0,0" />
                <TextBlock Text="Тесты проверяют доступность сетевых адресов."
                           Foreground="{StaticResource MutedBrush}" FontSize="13" TextWrapping="Wrap" Margin="1,8,0,0" />
              </StackPanel>
            </Border>
          </StackPanel>
        </ScrollViewer>

        <ScrollViewer x:Name="SettingsPage" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" Padding="28,0,28,24">
          <StackPanel>
            <Border Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1" CornerRadius="18" Padding="28" Margin="0,0,0,16">
              <StackPanel>
                <TextBlock Text="Запуск приложения" FontSize="20" FontWeight="SemiBold" />
                <TextBlock Text="Настройте, как NetShift запускается вместе с Windows. Служба DNS продолжит работать независимо от приложения."
                           Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,6,0,18" />
                <Border Background="{StaticResource PanelRaisedBrush}" BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="1" CornerRadius="12" Padding="16,14">
                  <CheckBox x:Name="AppAutoStartCheckBox" Content="Запускать NetShift вместе с Windows"
                            Click="AppAutoStart_Click" FontSize="15" VerticalAlignment="Center" />
                </Border>
              </StackPanel>
            </Border>
            <Border Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1" CornerRadius="18" Padding="28">
              <StackPanel>
                <TextBlock Text="Обновления" FontSize="20" FontWeight="SemiBold" />
                <TextBlock Text="NetShift проверяет последнюю доступную версию и обновляет установленное приложение с сохранением сетевых настроек."
                           Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,6,0,12" />
                <TextBlock Text="Проверить обновления можно в верхней части окна."
                           Foreground="{StaticResource MutedBrush}" FontSize="13" />
              </StackPanel>
            </Border>
          </StackPanel>
        </ScrollViewer>

        <ScrollViewer x:Name="AboutPage" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" Padding="28,0,28,24">
          <StackPanel>
            <Border Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1" CornerRadius="18" Padding="32">
              <StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,24">
                  <Border Width="58" Height="58" CornerRadius="15" Background="{StaticResource LogoBrush}"
                          BorderBrush="#14B8E8" BorderThickness="1">
                    <TextBlock Text="N" Foreground="White" FontSize="34" FontWeight="Bold"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                  </Border>
                  <StackPanel VerticalAlignment="Center" Margin="16,0,0,0">
                    <TextBlock Text="NetShift" FontSize="27" FontWeight="Bold" />
                    <TextBlock Text="Сеть под контролем" Foreground="{StaticResource MutedBrush}" FontSize="13" />
                  </StackPanel>
                </StackPanel>
                <TextBlock Text="Управление DNS и zapret в одном приложении. Настройки сети применяются только после подтверждения Windows."
                           Foreground="{StaticResource MutedBrush}" FontSize="15" TextWrapping="Wrap" />
                <Border Height="1" Background="{StaticResource BorderBrush}" Margin="0,24,0,18" />
                <TextBlock x:Name="AboutVersionText" Text="Версия NetShift" FontSize="15" FontWeight="SemiBold" />
                <TextBlock Text="NetShift · Windows" Foreground="{StaticResource MutedBrush}" FontSize="13" Margin="0,5,0,0" />
              </StackPanel>
            </Border>
          </StackPanel>
        </ScrollViewer>
      </Grid>
    </Grid>
  </Grid>
  </Grid>
</Window>
