<Window x:Class="NetShift.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="NetShift" Icon="Assets/NetShift.ico" Width="1120" Height="760" MinWidth="560" MinHeight="760"
        WindowStartupLocation="CenterScreen" WindowStyle="None" ResizeMode="NoResize"
        Background="{StaticResource CanvasBrush}" Foreground="{StaticResource TextBrush}">
    <shell:WindowChrome.WindowChrome>
    <shell:WindowChrome CaptionHeight="56" ResizeBorderThickness="0" GlassFrameThickness="0"
                        CornerRadius="0" UseAeroCaptionButtons="False" />
  </shell:WindowChrome.WindowChrome>
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="56" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>
    <Border Grid.RowSpan="2" Background="{StaticResource CanvasBrush}"
            BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" />

    <Grid Grid.Row="0" Background="{StaticResource SidebarBrush}" Panel.ZIndex="1">
      <Border Height="1" VerticalAlignment="Bottom" Background="{StaticResource BorderBrush}" />
      <DockPanel LastChildFill="False">
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="28,0,0,0">
          <Canvas Width="34" Height="34">
            <Canvas.RenderTransform><ScaleTransform ScaleX="1.15" ScaleY="1.15" /></Canvas.RenderTransform>
            <Path Data="M13,3 L21,8 L21,18 L13,23 L5,18 L5,8 Z M13,3 L13,13 M21,8 L13,13 L5,8 M21,18 L13,13 L13,23 M5,18 L13,13"
                  Stroke="{StaticResource AccentBrush}" StrokeThickness="1.6" />
            <Ellipse Canvas.Left="10" Canvas.Top="0" Width="6" Height="6" Fill="{StaticResource PanelBrush}" Stroke="{StaticResource AccentBrush}" StrokeThickness="1.5" />
            <Ellipse Canvas.Left="18" Canvas.Top="5" Width="6" Height="6" Fill="{StaticResource PanelBrush}" Stroke="{StaticResource AccentBrush}" StrokeThickness="1.5" />
            <Ellipse Canvas.Left="18" Canvas.Top="15" Width="6" Height="6" Fill="{StaticResource PanelBrush}" Stroke="{StaticResource AccentBrush}" StrokeThickness="1.5" />
            <Ellipse Canvas.Left="10" Canvas.Top="20" Width="6" Height="6" Fill="{StaticResource PanelBrush}" Stroke="{StaticResource AccentBrush}" StrokeThickness="1.5" />
            <Ellipse Canvas.Left="2" Canvas.Top="15" Width="6" Height="6" Fill="{StaticResource PanelBrush}" Stroke="{StaticResource AccentBrush}" StrokeThickness="1.5" />
            <Ellipse Canvas.Left="2" Canvas.Top="5" Width="6" Height="6" Fill="{StaticResource PanelBrush}" Stroke="{StaticResource AccentBrush}" StrokeThickness="1.5" />
            <Ellipse Canvas.Left="10" Canvas.Top="10" Width="6" Height="6" Fill="{StaticResource AccentBrush}" />
          </Canvas>
          <TextBlock Text="NetShift" FontSize="24" FontWeight="SemiBold" VerticalAlignment="Center" Margin="12,0,0,0" />
        </StackPanel>
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
          <Button Style="{StaticResource WindowControlButtonStyle}" shell:WindowChrome.IsHitTestVisibleInChrome="True"
                  Click="MinimizeWindow_Click" ToolTip="Свернуть">
            <TextBlock Text="&#xE921;" FontFamily="Segoe MDL2 Assets" FontSize="14" />
          </Button>
          <Button Style="{StaticResource WindowCloseButtonStyle}" shell:WindowChrome.IsHitTestVisibleInChrome="True"
                  Click="CloseWindow_Click" ToolTip="Закрыть">
            <TextBlock Text="&#xE8BB;" FontFamily="Segoe MDL2 Assets" FontSize="16" />
          </Button>
        </StackPanel>
      </DockPanel>
    </Grid>

    <Grid Grid.Row="1">
      <Grid.ColumnDefinitions>
      <ColumnDefinition x:Name="SidebarColumn" Width="240" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>

      <Border x:Name="SidebarPanel" Grid.Column="0" Background="{StaticResource SidebarBrush}" BorderBrush="{StaticResource BorderBrush}"
              BorderThickness="0,0,1,0" Padding="16,18,16,16">
        <StackPanel>
            <Button x:Name="DnsNavigationButton" Tag="dns" Click="NavigatePage_Click"
                    Style="{StaticResource NavigationButtonStyle}"
                    Background="{StaticResource PanelBrush}" BorderBrush="Transparent" Foreground="{StaticResource MutedBrush}">
              <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE774;" FontFamily="Segoe MDL2 Assets" FontSize="20" Foreground="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}" Margin="0,0,12,0"/><TextBlock Text="DNS" Foreground="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}" VerticalAlignment="Center"/></StackPanel>
            </Button>
            <Button x:Name="ZapretNavigationButton" Tag="zapret" Click="NavigatePage_Click"
                    Style="{StaticResource NavigationButtonStyle}" Margin="0,4,0,0"
                    Background="{StaticResource PanelBrush}" BorderBrush="Transparent" Foreground="{StaticResource MutedBrush}">
              <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE711;" FontFamily="Segoe MDL2 Assets" FontSize="20" Foreground="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}" Margin="0,0,12,0"/><TextBlock Text="zapret" Foreground="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}" VerticalAlignment="Center"/></StackPanel>
            </Button>
            <Button x:Name="SettingsNavigationButton" Tag="settings" Click="NavigatePage_Click"
                    Style="{StaticResource NavigationButtonStyle}" Margin="0,4,0,0"
                    Background="{StaticResource PanelBrush}" Foreground="{StaticResource MutedBrush}" BorderBrush="Transparent">
              <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE713;" FontFamily="Segoe MDL2 Assets" FontSize="20" Foreground="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}" Margin="0,0,12,0"/><TextBlock Text="Настройки" Foreground="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}" VerticalAlignment="Center"/></StackPanel>
            </Button>
          <StackPanel Margin="0,10,0,0">
            <Border Height="1" Background="{StaticResource BorderBrush}" Margin="0,0,0,8" />
            <TextBlock Text="Системные действия подтверждаются Windows."
                       Foreground="{StaticResource MutedBrush}" FontSize="10" TextWrapping="Wrap" Margin="2,6,2,0" />
            <Border Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                    CornerRadius="4" Padding="9" Margin="0,8,0,0">
              <StackPanel>
                <Grid>
                  <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                  <Ellipse x:Name="DnsServiceIndicator" Width="11" Height="11" Fill="#718096" Margin="0,3,9,0" />
                  <StackPanel Grid.Column="1">
                    <TextBlock Text="Служба DNS" FontSize="14" FontWeight="SemiBold" />
                    <TextBlock x:Name="DnsServiceStatusText" Text="Проверка состояния…" Foreground="{StaticResource MutedBrush}"
                               FontSize="11" TextWrapping="Wrap" />
                  </StackPanel>
                </Grid>
                <Button Content="Обновить статус" Click="RefreshDnsServiceStatus_Click" Padding="8,4" MinHeight="30" Margin="0,6,0,0" />
                <Grid x:Name="UpdateActionsGrid" Margin="0,7,0,0">
                  <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                  <Button x:Name="UpdateButton" Content="Проверить обновления" Click="UpdateButton_Click"
                          Grid.ColumnSpan="2" Padding="8,4" MinHeight="30" FontSize="12" ToolTip="Проверить наличие обновлений NetShift" />
                  <Button x:Name="InstallUpdateButton" Grid.Column="1" Content="Установить" Click="InstallUpdateButton_Click"
                          Visibility="Collapsed" Padding="8,4" MinHeight="30" Margin="6,0,0,0" />
                </Grid>
                <Button x:Name="InstallDnsServiceButton" Content="Установить службу DNS" Click="InstallDnsService_Click"
                        Visibility="Collapsed" Padding="8,4" MinHeight="30" Margin="0,6,0,0" />
                <Button x:Name="RemoveDnsServiceButton" Content="Удалить службу" Click="RemoveDnsService_Click"
                        Padding="8,4" MinHeight="30" Margin="0,6,0,0" />
                <TextBlock x:Name="UpdateStatusText" Text="Проверка обновлений…" Foreground="{StaticResource MutedBrush}"
                           FontSize="10" TextWrapping="Wrap" Margin="0,5,0,0" />
              </StackPanel>
            </Border>
          </StackPanel>
        </StackPanel>
      </Border>

      <Grid Grid.Column="1">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Canvas x:Name="BasicHeaderChevrons" Grid.Row="0" Panel.ZIndex="0" IsHitTestVisible="False">
          <Path Canvas.Left="0" Canvas.Top="1" Data="M 1,18 L 20,1 L 65,1 L 34,18 L 65,35 L 20,35 Z"
                Fill="#071821" Stroke="#16475A" StrokeThickness="1" Opacity="0.48" />
          <Path Canvas.Right="0" Canvas.Top="1" Data="M 64,18 L 45,1 L 0,1 L 31,18 L 0,35 L 45,35 Z"
                Fill="#071821" Stroke="#16475A" StrokeThickness="1" Opacity="0.48" />
        </Canvas>
        <Grid x:Name="PageHeaderGrid" Grid.Row="0" Margin="16,11,16,3">
          <TextBlock x:Name="PageTitleText" Text="Базовый режим" FontSize="19" FontWeight="SemiBold"
                     Foreground="{StaticResource AccentBrush}" VerticalAlignment="Center" />
          <Border x:Name="ModeSelectorBorder" Width="360" HorizontalAlignment="Right" VerticalAlignment="Center"
                  Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}"
                  BorderThickness="1" Padding="2">
            <Grid>
              <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
              <Button x:Name="BasicModeButton" Tag="basic" Content="Базовый" Click="ModeSelection_Click"
                      Style="{StaticResource ModeSelectionButtonStyle}" MinHeight="36"
                      AutomationProperties.Name="Базовый режим" />
              <Button x:Name="AdvancedModeButton" Grid.Column="1" Tag="advanced" Content="Расширенный"
                      Click="ModeSelection_Click" Style="{StaticResource ModeSelectionButtonStyle}" MinHeight="36"
                      AutomationProperties.Name="Расширенный режим" />
            </Grid>
          </Border>
        </Grid>

      <Grid Grid.Row="1">
        <Canvas x:Name="BasicSideRails" Panel.ZIndex="0" IsHitTestVisible="False">
          <Path Canvas.Left="0" Canvas.Top="16" Data="M 0,0 L 15,15 L 15,112 L 0,127"
                Stroke="{StaticResource AccentBrush}" StrokeThickness="1" Opacity="0.55" />
          <Path Canvas.Left="0" Canvas.Top="122" Data="M 0,0 L 24,24 L 24,276 L 0,300"
                Stroke="{StaticResource BorderBrush}" StrokeThickness="1" Opacity="0.75" />
          <Path Canvas.Right="0" Canvas.Top="16" Data="M 15,0 L 0,15 L 0,112 L 15,127"
                Stroke="{StaticResource AccentBrush}" StrokeThickness="1" Opacity="0.55" />
          <Path Canvas.Right="0" Canvas.Top="122" Data="M 24,0 L 0,24 L 0,276 L 24,300"
                Stroke="{StaticResource BorderBrush}" StrokeThickness="1" Opacity="0.75" />
          <Rectangle Canvas.Left="9" Canvas.Top="78" Width="5" Height="72" RadiusX="2" RadiusY="2"
                     Fill="{StaticResource AccentBrush}" Opacity="0.72">
            <Rectangle.Effect><DropShadowEffect Color="#12C8FF" BlurRadius="10" ShadowDepth="0" Opacity="0.75" /></Rectangle.Effect>
          </Rectangle>
          <Rectangle Canvas.Right="9" Canvas.Top="78" Width="5" Height="72" RadiusX="2" RadiusY="2"
                     Fill="{StaticResource AccentBrush}" Opacity="0.72">
            <Rectangle.Effect><DropShadowEffect Color="#12C8FF" BlurRadius="10" ShadowDepth="0" Opacity="0.75" /></Rectangle.Effect>
          </Rectangle>
          <Path Canvas.Left="18" Canvas.Top="236" Data="M 0,0 L 34,34 L 34,108 L 0,142"
                Stroke="#103448" StrokeThickness="1" Opacity="0.34" />
          <Path Canvas.Right="18" Canvas.Top="236" Data="M 34,0 L 0,34 L 0,108 L 34,142"
                Stroke="#103448" StrokeThickness="1" Opacity="0.34" />
        </Canvas>
        <ScrollViewer x:Name="BasicPage" Panel.ZIndex="1" VerticalScrollBarVisibility="Disabled" Padding="26,0,26,8">
          <StackPanel>
            <Grid Width="455" Height="62" HorizontalAlignment="Center" Margin="0,0,0,5">
              <Path Data="M 14,1 L 441,1 L 454,14 L 454,48 L 441,61 L 14,61 L 1,48 L 1,14 Z"
                    Stretch="Fill" Fill="{StaticResource PanelBrush}" Stroke="{StaticResource BorderBrush}" StrokeThickness="1.4">
                <Path.Effect><DropShadowEffect Color="#12C8FF" BlurRadius="11" ShadowDepth="0" Opacity="0.18" /></Path.Effect>
              </Path>
              <Grid Margin="22,7,18,7">
                <Grid.ColumnDefinitions><ColumnDefinition Width="22"/><ColumnDefinition Width="*"/><ColumnDefinition Width="34"/></Grid.ColumnDefinitions>
                <Ellipse x:Name="BasicModeStatusIndicator" Width="19" Height="19"
                         Fill="{Binding ElementName=BasicModeStatusText, Path=Foreground}" VerticalAlignment="Center">
                  <Ellipse.Effect><DropShadowEffect Color="#28E4B4" BlurRadius="14" ShadowDepth="0" Opacity="0.65" /></Ellipse.Effect>
                </Ellipse>
                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="10,0,0,0">
                  <TextBlock x:Name="BasicModeStatusText" Text="Подключение не активно" Foreground="{StaticResource MutedBrush}"
                             FontSize="20" FontWeight="SemiBold" />
                  <TextBlock x:Name="BasicModeProviderText" Text="Используется: Cloudflare" Foreground="{StaticResource MutedBrush}"
                             FontSize="14" />
                </StackPanel>
                <Canvas Grid.Column="2" Width="32" Height="28" VerticalAlignment="Center" HorizontalAlignment="Right">
                  <Path Data="M1,8 C8,0 24,0 31,8 M6,14 C12,8 20,8 26,14 M11,20 C14,17 18,17 21,20"
                        Stroke="{StaticResource AccentBrush}" StrokeThickness="3" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                  <Ellipse Canvas.Left="14" Canvas.Top="23" Width="4" Height="4" Fill="{StaticResource AccentBrush}" />
                </Canvas>
              </Grid>
            </Grid>

            <Grid Height="214">
              <Grid Width="326" Height="258" Margin="0,-22,0,-22" HorizontalAlignment="Center">
                <Ellipse Width="316" Height="242" Opacity="0.78">
                  <Ellipse.Fill>
                    <RadialGradientBrush Center="0.5,0.46" GradientOrigin="0.5,0.46" RadiusX="0.62" RadiusY="0.66">
                      <GradientStop Color="#2812A5D6" Offset="0" />
                      <GradientStop Color="#180A3448" Offset="0.62" />
                      <GradientStop Color="#000A3448" Offset="1" />
                    </RadialGradientBrush>
                  </Ellipse.Fill>
                </Ellipse>
                <Ellipse Width="326" Height="244" Stroke="#0E425B" StrokeThickness="1.5" Opacity="0.9" />
                <Ellipse Width="310" Height="228" Stroke="#0A2C3D" StrokeThickness="13" Opacity="0.78" />
                <Ellipse Width="264" Height="210" Stroke="#0B3549" StrokeThickness="1.4" Opacity="0.9" />
                <Path Data="M 50,38 L 76,60 M 276,38 L 250,60 M 30,107 L 57,107 M 296,107 L 269,107 M 50,176 L 76,154 M 276,176 L 250,154"
                      Stroke="#0C3A4E" StrokeThickness="1.3" Opacity="0.8" />
                <Path Data="M 31,74 L 38,76 M 28,83 L 36,85 M 27,92 L 36,94 M 26,101 L 35,103 M 26,110 L 35,112 M 27,119 L 36,121 M 28,128 L 36,130 M 31,137 L 38,139 M 295,74 L 288,76 M 298,83 L 290,85 M 299,92 L 290,94 M 300,101 L 291,103 M 300,110 L 291,112 M 299,119 L 290,121 M 298,128 L 290,130 M 295,137 L 288,139"
                      Stroke="#1B5C75" StrokeThickness="3.2" StrokeStartLineCap="Square" Opacity="0.88" />
                <Ellipse x:Name="BasicPowerHalo" Width="244" Height="184" Fill="Transparent"
                         Stroke="{StaticResource AccentBrush}" StrokeThickness="2" Opacity="0" RenderTransformOrigin="0.5,0.5">
                  <Ellipse.RenderTransform><ScaleTransform x:Name="PowerHaloScale" /></Ellipse.RenderTransform>
                  <Ellipse.Effect><DropShadowEffect Color="#12C8FF" BlurRadius="22" ShadowDepth="0" Opacity="0" /></Ellipse.Effect>
                </Ellipse>
                <Ellipse x:Name="BasicPowerOrbit" Width="226" Height="202" Fill="Transparent"
                         Stroke="{StaticResource AccentBrush}" StrokeThickness="1.8" StrokeDashArray="1.6 7.4"
                         StrokeDashCap="Round" Opacity="0" RenderTransformOrigin="0.5,0.5">
                  <Ellipse.RenderTransform><RotateTransform x:Name="PowerOrbitRotation" /></Ellipse.RenderTransform>
                  <Ellipse.Effect><DropShadowEffect Color="#12C8FF" BlurRadius="8" ShadowDepth="0" Opacity="0.55" /></Ellipse.Effect>
                </Ellipse>
                <Ellipse Width="206" Height="184" Stroke="{StaticResource AccentBrush}" StrokeThickness="2" Opacity="0.78" />
                <Ellipse x:Name="BasicPowerRipple" Width="206" Height="184" Fill="Transparent"
                         Stroke="{StaticResource AccentBrush}" StrokeThickness="2.5" Opacity="0" RenderTransformOrigin="0.5,0.5">
                  <Ellipse.RenderTransform><ScaleTransform x:Name="PowerRippleScale" /></Ellipse.RenderTransform>
                </Ellipse>
                <Button x:Name="BasicConnectionButton" Click="BasicConnectionButton_Click" Width="188" Height="188"
                        Background="Transparent" BorderThickness="0" Padding="0" HorizontalAlignment="Center" VerticalAlignment="Center"
                        Cursor="Hand" ToolTip="{Binding ElementName=BasicConnectionButtonText, Path=Text}"
                        AutomationProperties.Name="{Binding ElementName=BasicConnectionButtonText, Path=Text}">
                  <Button.Template>
                    <ControlTemplate TargetType="Button">
                      <Grid x:Name="PowerSurface" RenderTransformOrigin="0.5,0.5">
                        <Grid.RenderTransform><ScaleTransform /></Grid.RenderTransform>
                        <Ellipse x:Name="FocusRing" Stroke="#72E6FF" StrokeThickness="2" Margin="-4" Visibility="Collapsed" />
                        <ContentPresenter />
                      </Grid>
                      <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                          <Setter TargetName="PowerSurface" Property="Opacity" Value="0.88" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                          <Setter TargetName="PowerSurface" Property="RenderTransform">
                            <Setter.Value><ScaleTransform ScaleX="0.96" ScaleY="0.96" /></Setter.Value>
                          </Setter>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                          <Setter TargetName="FocusRing" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                          <Setter TargetName="PowerSurface" Property="Opacity" Value="0.45" />
                        </Trigger>
                      </ControlTemplate.Triggers>
                    </ControlTemplate>
                  </Button.Template>
                  <Image x:Name="BasicPowerButtonFace" Width="188" Height="188" Stretch="Fill" />
                </Button>
              </Grid>
            </Grid>
            <Button x:Name="BasicReconnectButton" Click="BasicConnectionButton_Click" Style="{StaticResource NeonActionButtonStyle}"
                    Width="347" Height="58" MinHeight="58" FontSize="20" HorizontalAlignment="Center" Margin="0,0,0,2"
                    ToolTip="Обновить DNS и переподключить zapret"
                    IsEnabled="{Binding IsEnabled, ElementName=BasicConnectionButton}"
                    AutomationProperties.Name="Переподключить">
              <StackPanel Orientation="Horizontal">
                <TextBlock Text="Переподключить" FontSize="23" FontWeight="SemiBold" VerticalAlignment="Center" />
                <Canvas Width="28" Height="28" VerticalAlignment="Center" Margin="12,0,0,0">
                  <Path Data="M 4,10 C 7,2 18,2 22,9 M 22,9 L 22,3 M 22,9 L 16,9 M 24,17 C 21,25 10,25 6,18 M 6,18 L 6,24 M 6,18 L 12,18"
                        Stroke="{StaticResource AccentBrush}" StrokeThickness="2.6"
                        StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
                </Canvas>
              </StackPanel>
            </Button>
            <TextBlock x:Name="BasicConnectionButtonText" Text="Включить" Visibility="Collapsed" />
            <TextBlock x:Name="BasicModeDetailText" Text="Нажмите, чтобы обновить DNS и zapret к выбранным переключателям."
                       Foreground="{StaticResource MutedBrush}" FontSize="16" TextWrapping="Wrap" TextAlignment="Center"
                       LineHeight="20" MaxWidth="440" HorizontalAlignment="Center" Margin="6,5,6,8" />

            <Grid Height="224">
              <Path Data="M 16,1 L 492,1 L 507,16 L 507,208 L 492,223 L 16,223 L 1,208 L 1,16 Z"
                    Stretch="Fill" Fill="{StaticResource PanelBrush}" Stroke="{StaticResource BorderBrush}" StrokeThickness="1.4">
                <Path.Effect><DropShadowEffect Color="#12C8FF" BlurRadius="12" ShadowDepth="0" Opacity="0.16" /></Path.Effect>
              </Path>
              <StackPanel Margin="15,9,15,9">
                <Grid Height="34" Margin="1,0,1,2">
                  <Grid.ColumnDefinitions><ColumnDefinition Width="36"/><ColumnDefinition Width="*"/><ColumnDefinition Width="20"/></Grid.ColumnDefinitions>
                  <TextBlock Text="&#xE713;" FontFamily="Segoe MDL2 Assets" FontSize="26"
                             Foreground="{StaticResource AccentBrush}" VerticalAlignment="Center" />
                  <TextBlock Grid.Column="1" Text="Параметры подключения" FontSize="19" FontWeight="SemiBold" VerticalAlignment="Center" />
                  <TextBlock Grid.Column="2" Text="&#xE70E;" FontFamily="Segoe MDL2 Assets" FontSize="20"
                             Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" HorizontalAlignment="Right" />
                </Grid>
                <Border Height="1" Background="{StaticResource BorderBrush}" Margin="0,0,0,2" />
                <Grid>
                  <Grid.ColumnDefinitions><ColumnDefinition Width="64"/><ColumnDefinition Width="1.07*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="54"/></Grid.ColumnDefinitions>
                  <Grid.RowDefinitions><RowDefinition Height="55"/><RowDefinition Height="55"/><RowDefinition Height="55"/></Grid.RowDefinitions>

                  <Border Width="44" Height="44" CornerRadius="22" Background="#091B25" BorderBrush="#16485D" BorderThickness="1"
                          VerticalAlignment="Center" HorizontalAlignment="Left" Margin="2,0,0,0">
                    <TextBlock Text="&#xE774;" FontFamily="Segoe MDL2 Assets" FontSize="25" Foreground="{StaticResource AccentBrush}"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                  </Border>
                  <TextBlock Grid.Column="1" Text="DNS-провайдер" Foreground="{StaticResource MutedBrush}"
                             VerticalAlignment="Center" FontSize="16" TextWrapping="Wrap" />
                  <ComboBox x:Name="BasicDnsProviderComboBox" Grid.Column="2" Grid.ColumnSpan="2" DisplayMemberPath="Name"
                            Width="196" HorizontalAlignment="Right" MinHeight="38" FontSize="16" Padding="12,6" VerticalAlignment="Center"
                            SelectionChanged="BasicDnsProviderComboBox_SelectionChanged" />
                  <Border Grid.Row="0" Grid.ColumnSpan="4" Height="1" Background="{StaticResource BorderBrush}"
                          VerticalAlignment="Bottom" Opacity="0.72" />

                  <Border Grid.Row="1" Width="44" Height="44" CornerRadius="22" Background="#091B25" BorderBrush="#16485D" BorderThickness="1"
                          VerticalAlignment="Center" HorizontalAlignment="Left" Margin="2,0,0,0">
                    <Path Width="23" Height="26" Stretch="Fill"
                          Data="M12,1 L22,5 L22,12 C22,18 18,23 12,26 C6,23 2,18 2,12 L2,5 Z M12,6 L12,20"
                          Stroke="{StaticResource AccentBrush}" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                          HorizontalAlignment="Center" VerticalAlignment="Center" />
                  </Border>
                  <TextBlock Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Text="Запрет фонового zapret-процесса"
                             Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" FontSize="16" TextWrapping="Wrap" MaxWidth="150" />
                  <CheckBox x:Name="BasicZapretServiceToggle" Grid.Row="1" Grid.Column="3" Style="{StaticResource CardSwitchStyle}"
                            IsChecked="True" Click="BasicZapretServiceToggle_Click" VerticalAlignment="Center"
                            ToolTip="Включено — запуск zapret как службы Windows, без фонового процесса."
                            AutomationProperties.Name="Запрет фонового zapret-процесса" />
                  <Border Grid.Row="1" Grid.ColumnSpan="4" Height="1" Background="{StaticResource BorderBrush}"
                          VerticalAlignment="Bottom" Opacity="0.72" />

                  <Border Grid.Row="2" Width="44" Height="44" CornerRadius="22" Background="#091B25" BorderBrush="#16485D" BorderThickness="1"
                          VerticalAlignment="Center" HorizontalAlignment="Left" Margin="2,0,0,0">
                    <TextBlock Text="&#xE945;" FontFamily="Segoe MDL2 Assets" FontSize="27" Foreground="{StaticResource AccentBrush}"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                  </Border>
                  <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Авто" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" FontSize="16" />
                    <Border Width="22" Height="22" CornerRadius="11" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                            Margin="9,0,0,0" ToolTip="Автоматически выбирается стратегия с наилучшим сохранённым рейтингом.">
                      <TextBlock Text="?" Foreground="{StaticResource MutedBrush}" FontSize="15"
                                 HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                  </StackPanel>
                  <ComboBox x:Name="BasicStrategyComboBox" Grid.Row="2" Grid.Column="2" DisplayMemberPath="Name"
                            MinHeight="38" FontSize="13" Padding="9,6" VerticalAlignment="Center" Visibility="Collapsed"
                            SelectionChanged="BasicStrategyComboBox_SelectionChanged"
                            ToolTip="Автоматически выбирается стратегия с наилучшим сохранённым рейтингом." />
                  <CheckBox x:Name="BasicAutoStrategyToggle" Grid.Row="2" Grid.Column="3" Style="{StaticResource CardSwitchStyle}"
                            IsChecked="True" Click="BasicAutoStrategyToggle_Click" VerticalAlignment="Center"
                            ToolTip="Автоматически выбрать стратегию по рейтингу"
                            AutomationProperties.Name="Автоматический выбор стратегии" />
                </Grid>
              </StackPanel>
            </Grid>
          </StackPanel>
        </ScrollViewer>

        <ScrollViewer x:Name="DnsPage" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" Padding="28,0,28,24">
          <StackPanel>
            <Border MaxWidth="960" HorizontalAlignment="Center" Background="{StaticResource PanelBrush}"
                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="24">
              <StackPanel>
                <Grid>
                  <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="34"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                  <StackPanel>
                    <DockPanel LastChildFill="False" Margin="0,0,0,10">
                      <TextBlock Text="Адаптер" FontSize="19" FontWeight="SemiBold" VerticalAlignment="Center" />
                      <Button Content="Обновить список" Click="RefreshAdapters_Click" DockPanel.Dock="Right" Padding="10,5" MinHeight="34" />
                    </DockPanel>
                    <ComboBox x:Name="AdapterComboBox" MinHeight="46" FontSize="16" />
                  </StackPanel>
                  <Border Grid.Column="1" Width="1" Background="{StaticResource BorderBrush}" HorizontalAlignment="Center" Margin="0,4" />
                  <StackPanel Grid.Column="2">
                    <DockPanel LastChildFill="False" Margin="0,0,0,10">
                      <TextBlock Text="Провайдер" FontSize="19" FontWeight="SemiBold" VerticalAlignment="Center" />
                      <Button x:Name="RefreshDnsAiButton" Content="Обновить DNS-AI" Click="RefreshDnsAi_Click" DockPanel.Dock="Right" Padding="10,5" MinHeight="34" />
                    </DockPanel>
                    <ComboBox x:Name="ProviderComboBox" DisplayMemberPath="Name" SelectionChanged="ProviderComboBox_SelectionChanged" MinHeight="46" FontSize="16" />
                  </StackPanel>
                </Grid>

                <Grid x:Name="DnsAddressSettingsPanel" Margin="0,22,0,0">
                  <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="34"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                  <StackPanel>
                    <TextBlock Text="DNS IPv4" FontSize="19" FontWeight="SemiBold" Margin="0,0,0,12" />
                    <Grid Margin="0,0,0,10"><Grid.ColumnDefinitions><ColumnDefinition Width="132"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                      <TextBlock Text="Основной" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" />
                      <TextBox x:Name="Ipv4TextBox" Grid.Column="1" ToolTip="Основной IPv4 адрес" MinHeight="46" FontSize="16" />
                    </Grid>
                    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="132"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                      <TextBlock Text="Альтернативный" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" />
                      <TextBox x:Name="Ipv4AlternateTextBox" Grid.Column="1" ToolTip="Дополнительный IPv4 адрес" MinHeight="46" FontSize="16" />
                    </Grid>
                  </StackPanel>
                  <Border Grid.Column="1" Width="1" Background="{StaticResource BorderBrush}" HorizontalAlignment="Center" Margin="0,4" />
                  <StackPanel Grid.Column="2">
                    <TextBlock Text="DNS IPv6" FontSize="19" FontWeight="SemiBold" Margin="0,0,0,12" />
                    <Grid Margin="0,0,0,10"><Grid.ColumnDefinitions><ColumnDefinition Width="132"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                      <TextBlock Text="Основной" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" />
                      <TextBox x:Name="Ipv6TextBox" Grid.Column="1" ToolTip="Основной IPv6 адрес" MinHeight="46" FontSize="16" />
                    </Grid>
                    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="132"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                      <TextBlock Text="Альтернативный" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" />
                      <TextBox x:Name="Ipv6AlternateTextBox" Grid.Column="1" ToolTip="Дополнительный IPv6 адрес" MinHeight="46" FontSize="16" />
                    </Grid>
                  </StackPanel>
                </Grid>

                <TextBlock Text="Режим защиты" FontSize="19" FontWeight="SemiBold" Margin="0,22,0,10" />
                <Grid>
                  <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                  <Border x:Name="LegacyModeCard" CornerRadius="4" Padding="14">
                    <Border.Style><Style TargetType="Border"><Setter Property="Background" Value="{StaticResource PanelBrush}"/><Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/><Setter Property="BorderThickness" Value="1"/><Style.Triggers><DataTrigger Binding="{Binding IsChecked, ElementName=LegacyModeRadio}" Value="True"><Setter Property="Background" Value="{StaticResource AccentDarkBrush}"/><Setter Property="BorderBrush" Value="{StaticResource AccentBrush}"/><Setter Property="BorderThickness" Value="2"/></DataTrigger></Style.Triggers></Style></Border.Style>
                    <RadioButton x:Name="LegacyModeRadio" GroupName="DnsMode" IsChecked="True" Foreground="White">
                      <StackPanel Margin="6,0,0,0"><TextBlock Text="Legacy: локальный прокси" FontSize="17" FontWeight="SemiBold" />
                        <TextBlock Text="Локальный прокси шифрует DNS через DoH." Foreground="{StaticResource MutedBrush}" FontSize="13" TextWrapping="Wrap" Margin="0,6,0,0" /></StackPanel>
                    </RadioButton>
                  </Border>
                  <Border x:Name="NativeModeCard" Grid.Column="2" CornerRadius="4" Padding="14">
                    <Border.Style><Style TargetType="Border"><Setter Property="Background" Value="{StaticResource PanelBrush}"/><Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/><Setter Property="BorderThickness" Value="1"/><Style.Triggers><DataTrigger Binding="{Binding IsChecked, ElementName=NativeModeRadio}" Value="True"><Setter Property="Background" Value="{StaticResource AccentDarkBrush}"/><Setter Property="BorderBrush" Value="{StaticResource AccentBrush}"/><Setter Property="BorderThickness" Value="2"/></DataTrigger></Style.Triggers></Style></Border.Style>
                    <RadioButton x:Name="NativeModeRadio" GroupName="DnsMode" Foreground="{StaticResource TextBrush}">
                      <StackPanel Margin="6,0,0,0"><TextBlock Text="Native: DNS Windows" FontSize="17" FontWeight="SemiBold" />
                        <TextBlock Text="Системный DNS Windows." Foreground="{StaticResource MutedBrush}" FontSize="13" TextWrapping="Wrap" Margin="0,6,0,0" /></StackPanel>
                    </RadioButton>
                  </Border>
                </Grid>

                <Grid x:Name="DnsDohSettingsPanel" Margin="0,20,0,0">
                  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                  <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                  <StackPanel Orientation="Horizontal" Grid.ColumnSpan="2" Margin="0,0,0,8">
                    <TextBlock Text="Шаблон DoH" FontSize="19" FontWeight="SemiBold" VerticalAlignment="Center" />
                    <CheckBox x:Name="DohEnabledCheckBox" Content="Использовать DoH в Windows" IsChecked="False" Margin="24,0,0,0" VerticalAlignment="Center" />
                  </StackPanel>
                  <TextBox x:Name="DohTemplateTextBox" Grid.Row="1" Grid.ColumnSpan="2" IsEnabled="{Binding IsChecked, ElementName=DohEnabledCheckBox}"
                           ToolTip="Например: https://dns.dns-ai.ru/dns-query" MinHeight="46" FontSize="16" />
                </Grid>
                <WrapPanel Margin="0,14,0,0">
                  <CheckBox x:Name="SupportIPv6CheckBox" Content="Поддержка IPv6" IsChecked="True" Margin="0,0,24,0" VerticalAlignment="Center" />
                  <CheckBox x:Name="ConfigureVpnAdaptersCheckBox" Content="Настраивать DNS для VPN-адаптеров" ToolTip="VPN-адаптеры появятся в списке сетевых адаптеров. DNS меняется только у выбранного подключения." IsChecked="False" Click="ConfigureVpnAdapters_Click" VerticalAlignment="Center" />
                </WrapPanel>
                <Border Height="1" Background="{StaticResource BorderBrush}" Margin="0,18,0,14" />
                <Grid>
                  <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="18"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                  <Button Content="Применить DNS" Background="{StaticResource AccentBrush}" Foreground="#03131D"
                          BorderBrush="{StaticResource AccentBrush}" Click="ApplyDns_Click" MinHeight="48" FontSize="17" />
                  <Button Grid.Column="2" Content="Вернуть DHCP" Click="ResetDns_Click" MinHeight="48" FontSize="17" />
                </Grid>
              </StackPanel>
            </Border>
          </StackPanel>
        </ScrollViewer>

        <ScrollViewer x:Name="ZapretPage" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" Padding="28,0,28,24">
          <StackPanel>
            <Border Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="26" Margin="0,0,0,16">
              <StackPanel>
                <Grid Margin="0,0,0,12">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <StackPanel>
                    <TextBlock Text="Пакет zapret" FontSize="17" FontWeight="SemiBold" />
                    <TextBlock Text="Пакет будет загружен и установлен в C:\NetShift."
                               Foreground="{StaticResource MutedBrush}" FontSize="13" TextWrapping="Wrap" Margin="0,4,10,0" />
                  </StackPanel>
                  <Button x:Name="DownloadLatestButton" Grid.Column="1" Content="Скачать последний релиз"
                          Background="{StaticResource AccentBrush}" Foreground="#03131D" BorderBrush="{StaticResource AccentBrush}"
                          Click="DownloadLatest_Click" Padding="14,8" MinHeight="38" />
                </Grid>
                <ProgressBar x:Name="DownloadProgressBar" Height="5" Minimum="0" Maximum="100" Visibility="Collapsed" />
                <TextBlock x:Name="DownloadStatusText" Text="Релиз ещё не проверен" Foreground="{StaticResource MutedBrush}" FontSize="13" Margin="2,8,0,12" />
                <TextBox x:Name="ZapretFolderTextBox" IsReadOnly="True" Visibility="Collapsed" VerticalContentAlignment="Center" />
                <TextBlock x:Name="ZapretStatusText" Visibility="Collapsed" Foreground="{StaticResource MutedBrush}" FontSize="13" Margin="2,10,0,0" />
              </StackPanel>
            </Border>

            <Border Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="18">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="1.1*" />
                  <ColumnDefinition Width="28" />
                  <ColumnDefinition Width="1*" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                  <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="&#xE713;" FontFamily="Segoe MDL2 Assets" FontSize="24" Foreground="{StaticResource AccentBrush}"
                               VerticalAlignment="Center" Margin="0,0,12,0" />
                    <TextBlock Text="Стратегия запуска" FontSize="17" FontWeight="SemiBold" VerticalAlignment="Center" />
                  </StackPanel>
                  <ComboBox x:Name="StrategyComboBox" Margin="0,10,0,0">
                    <ComboBox.ItemTemplate>
                      <DataTemplate>
                        <StackPanel Orientation="Horizontal">
                          <TextBlock Text="{Binding Name}" />
                          <TextBlock Text="{Binding YouTubeSpeedLabel}" Foreground="{StaticResource MutedBrush}"
                                     FontSize="10" Margin="8,0,0,0" VerticalAlignment="Center" />
                          <Ellipse Width="8" Height="8" Fill="{Binding HealthBrush}" Visibility="{Binding HealthVisibility}"
                                   Margin="8,0,0,0" VerticalAlignment="Center" ToolTip="{Binding HealthTooltip}">
                            <Ellipse.Style>
                              <Style TargetType="Ellipse">
                                <Style.Triggers>
                                  <DataTrigger Binding="{Binding IsRecommended}" Value="True">
                                    <DataTrigger.EnterActions>
                                      <BeginStoryboard x:Name="RecommendedStrategyPulse">
                                        <Storyboard AutoReverse="True" RepeatBehavior="Forever">
                                          <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0.35" To="1" Duration="0:0:0.8" />
                                        </Storyboard>
                                      </BeginStoryboard>
                                    </DataTrigger.EnterActions>
                                    <DataTrigger.ExitActions>
                                      <StopStoryboard BeginStoryboardName="RecommendedStrategyPulse" />
                                    </DataTrigger.ExitActions>
                                  </DataTrigger>
                                </Style.Triggers>
                              </Style>
                            </Ellipse.Style>
                          </Ellipse>
                        </StackPanel>
                      </DataTemplate>
                    </ComboBox.ItemTemplate>
                  </ComboBox>
                  <WrapPanel Margin="0,10,0,0">
                    <Button x:Name="StartStrategyButton" Content="Запустить стратегию" Background="{StaticResource AccentBrush}" Foreground="#03131D"
                            BorderBrush="{StaticResource AccentBrush}" Click="StartStrategy_Click" Padding="12,8" MinHeight="38" />
                    <Button x:Name="StopStrategyButton" Content="Остановить вручную" Click="StopStrategy_Click" Margin="8,0,0,0" Padding="12,8" MinHeight="38" />
                  </WrapPanel>
                  <TextBlock x:Name="ManualStrategyStatusText" Text="Ручной запуск не активен" Foreground="{StaticResource MutedBrush}"
                             FontSize="12" TextWrapping="Wrap" Margin="1,8,0,0" />
                </StackPanel>
                <Border Grid.Column="1" Width="1" Height="112" Background="{StaticResource BorderBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                <StackPanel Grid.Column="2" VerticalAlignment="Center">
                  <Border Background="{StaticResource PanelRaisedBrush}" BorderBrush="{StaticResource BorderBrush}"
                          BorderThickness="1" CornerRadius="4" Padding="12" Margin="0,0,0,8">
                    <Grid>
                      <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                      <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                      <TextBlock Text="Служба zapret" FontWeight="SemiBold" VerticalAlignment="Center" />
                      <CheckBox x:Name="ZapretServiceToggle" Grid.Column="1" Style="{StaticResource CardSwitchStyle}"
                                Click="ZapretServiceToggle_Click" ToolTip="Установить или удалить службу zapret"
                                AutomationProperties.Name="Служба zapret" />
                      <TextBlock x:Name="ServiceStatusText" Grid.Row="1" Text="Статус не проверен" Foreground="{StaticResource MutedBrush}"
                                 FontSize="12" TextTrimming="CharacterEllipsis" Margin="0,4,0,0" />
                      <WrapPanel Grid.Row="2" Grid.ColumnSpan="2" Margin="0,8,0,0">
                        <Button x:Name="ServiceRunButton" Content="Запустить службу" Click="ToggleServiceRun_Click"
                                Padding="10,6" MinHeight="34" Visibility="Collapsed" />
                        <Button x:Name="ApplyServiceStrategyButton" Content="Применить стратегию" Click="InstallService_Click"
                                Margin="6,0,0,0" Padding="10,6" MinHeight="34" Visibility="Collapsed" />
                      </WrapPanel>
                    </Grid>
                  </Border>
                  <Border Background="{StaticResource PanelRaisedBrush}" BorderBrush="{StaticResource BorderBrush}"
                          BorderThickness="1" CornerRadius="4" Padding="12">
                    <Grid>
                      <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                      <StackPanel>
                        <TextBlock Text="Автозапуск с Windows" FontWeight="SemiBold" />
                        <TextBlock x:Name="AppAutoStartStatusText" Text="Отключён" Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="0,4,0,0" />
                      </StackPanel>
                      <CheckBox x:Name="AppAutoStartCheckBox" Grid.Column="1" Style="{StaticResource CardSwitchStyle}"
                                Click="AppAutoStart_Click" ToolTip="Запускать NetShift при входе в Windows. DNS-служба продолжит работать независимо от приложения."
                                AutomationProperties.Name="Автозапуск NetShift с Windows" />
                    </Grid>
                  </Border>
                </StackPanel>
              </Grid>
            </Border>

            <Border Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                    CornerRadius="5" Padding="16" Margin="0,12,0,0">
              <StackPanel>
                <Grid>
                  <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                  <TextBlock Text="Проверка стратегий" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center" />
                  <TextBlock x:Name="ZapretTestPhaseText" Grid.Column="1" Text="Ожидает проверки" Foreground="{StaticResource MutedBrush}"
                             FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,12,0" />
                  <Button x:Name="CheckActiveStrategyButton" Grid.Column="2" Content="Проверить" Click="CheckActiveStrategy_Click"
                          Padding="12,7" MinHeight="36" />
                </Grid>
                <TextBlock x:Name="ZapretHealthStatusText" Text="Проверка стратегий ещё не выполнялась." Foreground="{StaticResource MutedBrush}"
                           FontSize="12" TextWrapping="Wrap" Margin="0,8,0,0" />
                <TextBlock x:Name="ZapretTestStrategyText" Text="Сверка по targets.txt: три curl пробы и ping для каждой цели. Автоперебор запускает оригинальные general*.bat; подготовка может включить TCP timestamps. Активную службу тестирую без остановки."
                           Foreground="{StaticResource MutedBrush}" FontSize="12" TextWrapping="Wrap" Margin="0,4,0,8" />
                <ProgressBar x:Name="ZapretTestProgressBar" Height="4" IsIndeterminate="False" Visibility="Collapsed" Margin="0,0,0,8" />
                <UniformGrid Columns="3">
                  <Border Background="{StaticResource PanelRaisedBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="3" Padding="9" Margin="0,0,6,0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                      <Ellipse x:Name="DiscordTestIndicator" Width="9" Height="9" Fill="#718096" Margin="0,0,8,0" />
                      <StackPanel><TextBlock Text="Discord" FontWeight="SemiBold"/><TextBlock x:Name="DiscordTestStatusText" Text="Не проверялся" Foreground="{StaticResource MutedBrush}" FontSize="10" /></StackPanel>
                    </StackPanel>
                  </Border>
                  <Border Background="{StaticResource PanelRaisedBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="3" Padding="9" Margin="3,0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                      <Ellipse x:Name="YouTubeTestIndicator" Width="9" Height="9" Fill="#718096" Margin="0,0,8,0" />
                      <StackPanel><TextBlock Text="YouTube" FontWeight="SemiBold"/><TextBlock x:Name="YouTubeTestStatusText" Text="Не проверялся" Foreground="{StaticResource MutedBrush}" FontSize="10" /></StackPanel>
                    </StackPanel>
                  </Border>
                  <Border Background="{StaticResource PanelRaisedBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="3" Padding="9" Margin="6,0,0,0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                      <Ellipse x:Name="GoogleTestIndicator" Width="9" Height="9" Fill="#718096" Margin="0,0,8,0" />
                      <StackPanel><TextBlock Text="Google" FontWeight="SemiBold"/><TextBlock x:Name="GoogleTestStatusText" Text="Не проверялся" Foreground="{StaticResource MutedBrush}" FontSize="10" /></StackPanel>
                    </StackPanel>
                  </Border>
                  <Border Background="{StaticResource PanelRaisedBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="3" Padding="9" Margin="0,6,6,0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                      <Ellipse x:Name="CloudflareTestIndicator" Width="9" Height="9" Fill="#718096" Margin="0,0,8,0" />
                      <StackPanel><TextBlock Text="Cloudflare" FontWeight="SemiBold"/><TextBlock x:Name="CloudflareTestStatusText" Text="Не проверялся" Foreground="{StaticResource MutedBrush}" FontSize="10" /></StackPanel>
                    </StackPanel>
                  </Border>
                  <Border Background="{StaticResource PanelRaisedBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="3" Padding="9" Margin="3,6,3,0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                      <Ellipse x:Name="DnsTestIndicator" Width="9" Height="9" Fill="#718096" Margin="0,0,8,0" />
                      <StackPanel><TextBlock Text="DNS" FontWeight="SemiBold"/><TextBlock x:Name="DnsTestStatusText" Text="Не проверялся" Foreground="{StaticResource MutedBrush}" FontSize="10" /></StackPanel>
                    </StackPanel>
                  </Border>
                  <Border Background="{StaticResource PanelRaisedBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="3" Padding="9" Margin="6,6,0,0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                      <Ellipse x:Name="OtherTestIndicator" Width="9" Height="9" Fill="#718096" Margin="0,0,8,0" />
                      <StackPanel><TextBlock Text="Другие цели" FontWeight="SemiBold"/><TextBlock x:Name="OtherTestStatusText" Text="Не проверялись" Foreground="{StaticResource MutedBrush}" FontSize="10" /></StackPanel>
                    </StackPanel>
                  </Border>
                </UniformGrid>
              </StackPanel>
            </Border>

            <Button x:Name="ZapretAdvancedToggleButton" Content="Дополнительные настройки и диагностика ▼"
                    Click="ToggleZapretAdvanced_Click" HorizontalAlignment="Left" Margin="0,14,0,0" />
            <Grid Margin="0,8,0,0">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.18*" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="1*" />
              </Grid.ColumnDefinitions>
              <Border x:Name="PackageSettingsPanel" Grid.Column="0" Background="{StaticResource PanelBrush}"
                      BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="4" Padding="14" Visibility="Collapsed">
                <StackPanel>
                  <TextBlock Text="Параметры пакета" FontSize="16" FontWeight="SemiBold" />
                  <Grid Margin="0,10,0,0">
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                    <TextBlock Text="Игровой фильтр" Foreground="{StaticResource MutedBrush}" FontSize="12" />
                    <TextBlock Grid.Column="1" Text="TCP порты" Foreground="{StaticResource MutedBrush}" FontSize="12" />
                    <TextBlock Grid.Column="2" Text="UDP порты" Foreground="{StaticResource MutedBrush}" FontSize="12" />
                    <ComboBox x:Name="GameFilterModeComboBox" Grid.Row="1" Margin="0,4,5,0" MinHeight="36" FontSize="12" />
                    <TextBox x:Name="GameFilterTcpTextBox" Grid.Row="1" Grid.Column="1" Margin="0,4,5,0" MinHeight="36" Padding="8,6" FontSize="12" ToolTip="Например: 1024-65535" />
                    <TextBox x:Name="GameFilterUdpTextBox" Grid.Row="1" Grid.Column="2" Margin="0,4,0,0" MinHeight="36" Padding="8,6" FontSize="12" ToolTip="Например: 1024-65535" />
                  </Grid>
                  <Grid Margin="0,9,0,0">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="0.95*" /><ColumnDefinition Width="1.25*" /></Grid.ColumnDefinitions>
                    <StackPanel>
                      <TextBlock Text="IPSet-фильтр" Foreground="{StaticResource MutedBrush}" FontSize="12" />
                      <ComboBox x:Name="IpSetModeComboBox" Margin="0,4,5,0" MinHeight="36" FontSize="12" />
                    </StackPanel>
                    <CheckBox x:Name="AutoUpdateCheckBox" Grid.Column="1" FontSize="12" VerticalAlignment="Center" Margin="8,10,0,0">
                      <TextBlock Text="Проверять релиз в NetShift перед запуском" TextWrapping="Wrap" />
                    </CheckBox>
                  </Grid>
                  <WrapPanel Margin="0,10,0,0">
                    <Button x:Name="SavePackageSettingsButton" Content="Сохранить" Click="SavePackageSettings_Click" Padding="8,6" MinHeight="34" />
                    <Button x:Name="UpdateIpSetButton" Content="Обновить IPSet" Click="UpdateIpSet_Click" Margin="6,0,0,0" Padding="8,6" MinHeight="34" />
                    <Button x:Name="CheckReleaseButton" Content="Проверить версию" Click="CheckRelease_Click" Margin="6,0,0,0" Padding="8,6" MinHeight="34" />
                  </WrapPanel>
                </StackPanel>
              </Border>
              <Border Grid.Column="1" Width="1" Background="{StaticResource BorderBrush}" Margin="0,10" />
              <Border x:Name="ToolsAndDiagnosticsPanel" Grid.Column="2" Background="{StaticResource PanelBrush}"
                      BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="4" Padding="14" Visibility="Collapsed">
                <StackPanel>
                  <TextBlock Text="Инструменты и диагностика" FontSize="16" FontWeight="SemiBold" />
                  <Grid Margin="0,10,0,0">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="8" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                    <ComboBox x:Name="FakeTargetComboBox" Grid.Column="0" MinHeight="36" FontSize="12" />
                    <ComboBox x:Name="FakeFileComboBox" Grid.Column="2" MinHeight="36" FontSize="12" />
                  </Grid>
                  <Grid Margin="0,8,0,0">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <TextBlock Text="Активный UDP fake-файл" Foreground="{StaticResource MutedBrush}" FontSize="12" VerticalAlignment="Center" />
                    <Button x:Name="ReplaceFakeButton" Grid.Column="1" Content="Заменить" Click="ReplaceFake_Click" Padding="9,6" MinHeight="34" />
                  </Grid>
                  <Grid Margin="0,9,0,0">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="7" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                    <Button x:Name="RunDiagnosticsButton" Content="Диагностика" Click="RunDiagnostics_Click" ToolTip="Запустить диагностику"
                            Padding="6,6" MinHeight="34" FontSize="12" />
                    <Button x:Name="RunUpstreamTestsButton" Grid.Column="2" Content="Тесты zapret" Click="RunUpstreamTests_Click" ToolTip="Запустить тесты zapret"
                            Padding="6,6" MinHeight="34" FontSize="12" />
                    <Button x:Name="CheckHostsButton" Grid.Row="1" Content="Проверить hosts" Click="CheckHosts_Click"
                            Margin="0,6,0,0" Padding="6,6" MinHeight="34" FontSize="12" />
                    <Button x:Name="RestoreHostsButton" Grid.Row="1" Grid.Column="2" Content="Восстановить hosts" Click="RestoreHostsBackup_Click"
                            Margin="0,6,0,0" Padding="6,6" MinHeight="34" FontSize="12" />
                  </Grid>
                  <TextBox x:Name="ToolsOutputTextBox" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                           MinHeight="44" MaxHeight="72" Padding="8,6" FontSize="12" Margin="0,9,0,0" />
                </StackPanel>
              </Border>
            </Grid>
          </StackPanel>
        </ScrollViewer>

        <ScrollViewer x:Name="SettingsPage" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" Padding="28,0,28,24">
          <StackPanel>
            <Border Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1" Padding="24">
              <StackPanel>
                <TextBlock Text="Параметры базового режима" FontSize="20" FontWeight="SemiBold" />
                <Grid Margin="0,12,0,0">
                  <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                  <Grid.RowDefinitions><RowDefinition Height="54"/><RowDefinition Height="54"/></Grid.RowDefinitions>
                  <TextBlock Text="Включать DNS при подключении" Foreground="{StaticResource MutedBrush}"
                             VerticalAlignment="Center" FontSize="15" />
                  <CheckBox x:Name="BasicDnsToggle" Grid.Column="1" Style="{StaticResource CardSwitchStyle}"
                            IsChecked="True" Click="BasicModuleToggle_Click" VerticalAlignment="Center"
                            AutomationProperties.Name="Включать DNS при подключении" />
                  <Border Grid.Row="0" Grid.ColumnSpan="2" Height="1" Background="{StaticResource BorderBrush}"
                          VerticalAlignment="Bottom" Opacity="0.65" />
                  <TextBlock Grid.Row="1" Text="Включать zapret при подключении" Foreground="{StaticResource MutedBrush}"
                             VerticalAlignment="Center" FontSize="15" />
                  <CheckBox x:Name="BasicZapretToggle" Grid.Row="1" Grid.Column="1" Style="{StaticResource CardSwitchStyle}"
                            IsChecked="True" Click="BasicModuleToggle_Click" VerticalAlignment="Center"
                            AutomationProperties.Name="Включать zapret при подключении" />
                </Grid>
              </StackPanel>
            </Border>
            <Border Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1" CornerRadius="6" Padding="28">
              <StackPanel>
                <TextBlock Text="Обновления" FontSize="20" FontWeight="SemiBold" />
                <TextBlock Text="NetShift проверяет обновления при запуске. Установить доступную версию можно кнопкой «Проверить обновления» в верхней панели; сетевые настройки сохраняются."
                           Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,6,0,0" />
              </StackPanel>
            </Border>
            <Border Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1" CornerRadius="6" Padding="24" Margin="0,12,0,0">
              <StackPanel>
                <TextBlock Text="О программе" FontSize="20" FontWeight="SemiBold" />
                <Grid Margin="0,14,0,0">
                  <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                  <Border Width="48" Height="48" CornerRadius="4" Background="{StaticResource LogoBrush}"
                          BorderBrush="{StaticResource AccentBrush}" BorderThickness="1">
                    <TextBlock Text="N" Foreground="White" FontSize="28" FontWeight="Bold"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                  </Border>
                  <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="14,0,0,0">
                    <TextBlock Text="NetShift" FontSize="19" FontWeight="Bold" />
                    <TextBlock x:Name="AboutVersionText" Text="Версия NetShift" Foreground="{StaticResource MutedBrush}" FontSize="13" Margin="0,3,0,0" />
                  </StackPanel>
                </Grid>
                <TextBlock Text="NetShift объединяет настройку DNS в Windows и управление zapret от Flowseal."
                           Foreground="{StaticResource MutedBrush}" FontSize="14" TextWrapping="Wrap" Margin="0,14,0,0" />
                <StackPanel Margin="0,10,0,0">
                  <TextBlock Text="DNS: выбор провайдера или собственных IPv4/IPv6-адресов, DoH и отдельная служба, работающая независимо от приложения."
                             Foreground="{StaticResource MutedBrush}" FontSize="13" TextWrapping="Wrap" />
                  <TextBlock Text="zapret: загрузка официального пакета, запуск стратегий вручную или как службы, проверка доступности сайтов и диагностика."
                             Foreground="{StaticResource MutedBrush}" FontSize="13" TextWrapping="Wrap" Margin="0,6,0,0" />
                  <TextBlock Text="Системные изменения Windows выполняются после подтверждения администратора."
                             Foreground="{StaticResource MutedBrush}" FontSize="13" TextWrapping="Wrap" Margin="0,10,0,0" />
                </StackPanel>
              </StackPanel>
            </Border>
          </StackPanel>
        </ScrollViewer>

      </Grid>
    </Grid>
  </Grid>
    <Path Grid.RowSpan="2" Panel.ZIndex="10" IsHitTestVisible="False"
          Data="M 18,1 L 542,1 L 559,18 L 559,742 L 542,759 L 18,759 L 1,742 L 1,18 Z"
          Stretch="Fill" Fill="Transparent" Stroke="{StaticResource BorderBrush}" StrokeThickness="1.2" Opacity="0.8">
      <Path.Effect><DropShadowEffect Color="#12C8FF" BlurRadius="11" ShadowDepth="0" Opacity="0.14" /></Path.Effect>
    </Path>
    <Path Grid.RowSpan="2" Panel.ZIndex="11" IsHitTestVisible="False"
          Data="M 18,1 L 38,1 M 1,18 L 1,38 M 542,1 L 522,1 M 559,18 L 559,38 M 18,759 L 38,759 M 1,742 L 1,722 M 542,759 L 522,759 M 559,742 L 559,722"
          Stretch="Fill" Fill="Transparent" Stroke="{StaticResource AccentBrush}" StrokeThickness="2.2" Opacity="0.88">
      <Path.Effect><DropShadowEffect Color="#12C8FF" BlurRadius="13" ShadowDepth="0" Opacity="0.7" /></Path.Effect>
    </Path>
    <Path Grid.RowSpan="2" Panel.ZIndex="11" IsHitTestVisible="False"
          Data="M 18,1 L 542,1 M 18,759 L 542,759"
          Stretch="Fill" Fill="Transparent" Stroke="{StaticResource AccentBrush}" StrokeThickness="1.5" Opacity="0.72">
      <Path.Effect><DropShadowEffect Color="#12C8FF" BlurRadius="12" ShadowDepth="0" Opacity="0.54" /></Path.Effect>
    </Path>
  </Grid>
</Window>
