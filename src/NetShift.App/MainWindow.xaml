<Window x:Class="NetShift.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="NetShift" Icon="Assets/NetShift.ico" Width="980" Height="780" MinWidth="820" MinHeight="650"
        WindowStartupLocation="CenterScreen" Background="{StaticResource CanvasBrush}"
        Foreground="{StaticResource TextBrush}">
  <Grid Margin="22">
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="172" />
      <ColumnDefinition Width="*" />
    </Grid.ColumnDefinitions>

    <Border Grid.Column="0" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}"
            BorderThickness="1" CornerRadius="16" Padding="14" Margin="0,0,16,0">
      <DockPanel LastChildFill="True">
        <StackPanel DockPanel.Dock="Top">
          <StackPanel Orientation="Horizontal" Margin="2,4,0,24">
            <Border Width="38" Height="38" CornerRadius="12" Background="{StaticResource AccentDarkBrush}">
              <TextBlock Text="N" Foreground="{StaticResource AccentBrush}" FontSize="22" FontWeight="Bold"
                         HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <TextBlock Text="NetShift" FontSize="18" FontWeight="Bold" VerticalAlignment="Center" Margin="10,0,0,0" />
          </StackPanel>
          <Button x:Name="DnsNavigationButton" Tag="dns" Content="DNS" Click="NavigatePage_Click"
                  HorizontalContentAlignment="Left" Padding="14,11" FontSize="15"
                  Background="{StaticResource AccentDarkBrush}" BorderBrush="#1B5C5B" Foreground="{StaticResource AccentBrush}" />
          <Button x:Name="ZapretNavigationButton" Tag="zapret" Content="zapret" Click="NavigatePage_Click"
                  HorizontalContentAlignment="Left" Padding="14,11" FontSize="15" Margin="0,8,0,0"
                  Background="Transparent" BorderBrush="Transparent" Foreground="{StaticResource MutedBrush}" />
        </StackPanel>
        <TextBlock DockPanel.Dock="Bottom" Text="Системные действия подтверждаются Windows."
                   Foreground="{StaticResource MutedBrush}" FontSize="12" TextWrapping="Wrap" Margin="2,12,2,2" />
      </DockPanel>
    </Border>

    <Grid Grid.Column="1">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
      </Grid.RowDefinitions>
      <Grid Grid.Row="0" Margin="0,0,0,12">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <TextBlock x:Name="PageTitleText" Text="DNS" FontSize="25" FontWeight="SemiBold" VerticalAlignment="Center" />
        <StackPanel Grid.Column="1" Width="260" HorizontalAlignment="Right">
          <CheckBox x:Name="AppAutoStartCheckBox" Content="Запускать NetShift вместе с Windows" Click="AppAutoStart_Click"
                    HorizontalAlignment="Right" Margin="0,0,0,4" FontSize="13" />
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="UpdateStatusText" Text="Проверка обновлений…" Foreground="{StaticResource MutedBrush}"
                       FontSize="12" VerticalAlignment="Center" TextWrapping="Wrap" />
            <Button x:Name="UpdateButton" Grid.Column="1" Content="Проверить обновления" Click="UpdateButton_Click"
                    Padding="10,6" MinHeight="34" Margin="8,0,0,0" />
          </Grid>
        </StackPanel>
      </Grid>

      <Grid Grid.Row="1">
        <ScrollViewer x:Name="DnsPage" VerticalScrollBarVisibility="Auto" Padding="2,4,8,10">
          <StackPanel>
            <Border Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="16" Padding="20" Margin="0,0,0,14">
              <StackPanel>
                <Grid Margin="0,0,0,12">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <StackPanel>
                    <TextBlock Text="Сетевой адаптер" FontSize="17" FontWeight="SemiBold" />
                    <TextBlock Text="Настройки применяются к выбранному адаптеру." Foreground="{StaticResource MutedBrush}" FontSize="13" Margin="0,4,0,0" />
                  </StackPanel>
                  <Button Grid.Column="1" Content="Обновить список" Click="RefreshAdapters_Click" Padding="13,7" MinHeight="36" />
                </Grid>
                <ComboBox x:Name="AdapterComboBox" SelectionChanged="AdapterComboBox_SelectionChanged" />
                <TextBlock x:Name="CurrentDnsText" Text="Текущие DNS: загрузка…" Foreground="{StaticResource MutedBrush}" FontSize="13" TextWrapping="Wrap" Margin="2,10,0,0" />
              </StackPanel>
            </Border>

            <Border Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="16" Padding="20" Margin="0,0,0,14">
              <StackPanel>
                <TextBlock Text="Служба DNS Windows" FontSize="17" FontWeight="SemiBold" />
                <TextBlock Text="Запускается вместе с Windows и применяет сохранённый DNS-профиль."
                           Foreground="{StaticResource MutedBrush}" FontSize="13" TextWrapping="Wrap" Margin="0,4,0,10" />
                <TextBlock x:Name="DnsServiceStatusText" Text="Служба DNS: статус не проверен" Foreground="{StaticResource MutedBrush}" FontSize="13" TextWrapping="Wrap" Margin="1,0,0,10" />
                <WrapPanel>
                  <Button x:Name="InstallDnsServiceButton" Content="Установить / обновить службу DNS" Click="InstallDnsService_Click"
                          Visibility="Collapsed" Background="{StaticResource AccentBrush}" Foreground="#07151A"
                          BorderBrush="{StaticResource AccentBrush}" />
                  <Button x:Name="RemoveDnsServiceButton" Content="Удалить службу" Click="RemoveDnsService_Click" Margin="8,0,0,0" />
                  <Button Content="Обновить статус" Click="RefreshDnsServiceStatus_Click" Margin="8,0,0,0" />
                </WrapPanel>
              </StackPanel>
            </Border>

            <Border Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="16" Padding="20">
              <StackPanel>
                <Grid Margin="0,0,0,12">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <StackPanel>
                    <TextBlock Text="DNS-провайдер" FontSize="17" FontWeight="SemiBold" />
                    <TextBlock Text="Выберите провайдера или укажите адреса вручную." Foreground="{StaticResource MutedBrush}" FontSize="13" Margin="0,4,0,0" />
                  </StackPanel>
                  <Button x:Name="RefreshDnsAiButton" Grid.Column="1" Content="Обновить DNS-AI" Click="RefreshDnsAi_Click" Padding="12,6" MinHeight="34" />
                </Grid>
                <ComboBox x:Name="ProviderComboBox" DisplayMemberPath="Name" SelectionChanged="ProviderComboBox_SelectionChanged" />
                <Grid Margin="0,15,0,0">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="14" />
                    <ColumnDefinition Width="*" />
                  </Grid.ColumnDefinitions>
                  <StackPanel>
                    <TextBlock Text="DNS IPv4" Foreground="{StaticResource MutedBrush}" FontSize="13" Margin="1,0,0,7" />
                    <TextBox x:Name="Ipv4TextBox" ToolTip="Например: 1.1.1.1, 1.0.0.1" />
                  </StackPanel>
                  <StackPanel Grid.Column="2">
                    <TextBlock Text="DNS IPv6" Foreground="{StaticResource MutedBrush}" FontSize="13" Margin="1,0,0,7" />
                    <TextBox x:Name="Ipv6TextBox" ToolTip="Можно оставить пустым" />
                  </StackPanel>
                </Grid>
                <TextBlock Text="Несколько адресов указывайте через запятую."
                           Foreground="{StaticResource MutedBrush}" FontSize="13" TextWrapping="Wrap" Margin="1,10,0,0" />
                <CheckBox x:Name="SupportIPv6CheckBox" Content="Поддержка IPv6" IsChecked="True" Margin="1,10,0,0" />
                <CheckBox x:Name="ConfigureVpnAdaptersCheckBox" Content="Настраивать DNS для VPN-адаптеров" ToolTip="VPN-адаптеры появятся в списке сетевых адаптеров. DNS меняется только у выбранного подключения." IsChecked="False" Click="ConfigureVpnAdapters_Click" Margin="1,6,0,0" />
                <TextBlock Text="Способ защиты DNS-запросов" FontSize="13" FontWeight="SemiBold" Margin="1,15,0,8" />
                <StackPanel>
                  <RadioButton x:Name="LegacyModeRadio" GroupName="DnsMode" IsChecked="True" Content="Legacy: локальный прокси" Margin="1,2" />
                  <TextBlock Text="Запросы идут через локальный прокси NetShift и шифруются через DoH. Работает, пока NetShift запущен."
                             Foreground="{StaticResource MutedBrush}" FontSize="13" TextWrapping="Wrap" Margin="20,0,0,8" />
                  <RadioButton x:Name="NativeModeRadio" GroupName="DnsMode" Content="Native: DNS Windows" Margin="1,2" />
                  <TextBlock Text="DoH обрабатывает Windows. Профиль поддерживает служба NetShift."
                             Foreground="{StaticResource MutedBrush}" FontSize="13" TextWrapping="Wrap" Margin="20,0,0,8" />
                </StackPanel>
                <CheckBox x:Name="DohEnabledCheckBox" Content="Включить DoH в Windows"
                          IsChecked="False" Margin="1,8,0,7" />
                <TextBox x:Name="DohTemplateTextBox" IsEnabled="{Binding IsChecked, ElementName=DohEnabledCheckBox}"
                         ToolTip="Например: https://dns.dns-ai.ru/dns-query" />
                <TextBlock x:Name="DnsProviderStatusText" Text="DNS-AI: загружаются актуальные настройки сайта…"
                           Foreground="{StaticResource MutedBrush}" FontSize="13" TextWrapping="Wrap" Margin="1,8,0,0" />
                <StackPanel Orientation="Horizontal" Margin="0,17,0,0">
                  <Button Content="Применить DNS" Background="{StaticResource AccentBrush}" Foreground="#07151A"
                          BorderBrush="{StaticResource AccentBrush}" Click="ApplyDns_Click" />
                  <Button Content="Вернуть DHCP" Margin="10,0,0,0" Click="ResetDns_Click" />
                </StackPanel>
              </StackPanel>
            </Border>
          </StackPanel>
        </ScrollViewer>

        <ScrollViewer x:Name="ZapretPage" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" Padding="2,4,8,10">
          <StackPanel>
            <Border Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="16" Padding="20" Margin="0,0,0,14">
              <StackPanel>
                <Grid Margin="0,0,0,12">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <StackPanel>
                    <TextBlock Text="Пакет zapret" FontSize="17" FontWeight="SemiBold" />
                    <TextBlock Text="Пакет будет загружен и установлен в C:\NetShift."
                               Foreground="{StaticResource MutedBrush}" FontSize="13" TextWrapping="Wrap" Margin="0,4,10,0" />
                  </StackPanel>
                  <Button x:Name="DownloadLatestButton" Grid.Column="1" Content="Скачать последний релиз"
                          Background="{StaticResource AccentBrush}" Foreground="#07151A" BorderBrush="{StaticResource AccentBrush}"
                          Click="DownloadLatest_Click" Padding="14,8" MinHeight="38" />
                </Grid>
                <ProgressBar x:Name="DownloadProgressBar" Height="5" Minimum="0" Maximum="100" Visibility="Collapsed" />
                <TextBlock x:Name="DownloadStatusText" Text="Релиз ещё не проверен" Foreground="{StaticResource MutedBrush}" FontSize="13" Margin="2,8,0,12" />
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <TextBox x:Name="ZapretFolderTextBox" IsReadOnly="True" VerticalContentAlignment="Center" />
                  <Button Grid.Column="1" Content="Выбрать папку" Click="ChooseZapretFolder_Click" Margin="10,0,0,0" />
                </Grid>
                <TextBlock x:Name="ZapretStatusText" Text="Папка zapret не выбрана" Foreground="{StaticResource MutedBrush}" FontSize="13" Margin="2,10,0,0" />
              </StackPanel>
            </Border>

            <Border Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="16" Padding="20">
              <StackPanel>
                <TextBlock Text="Запуск и служба Windows" FontSize="17" FontWeight="SemiBold" />
                <TextBlock Text="Выберите стратегию для запуска или службы Windows."
                           Foreground="{StaticResource MutedBrush}" FontSize="13" TextWrapping="Wrap" Margin="0,4,0,14" />
                <ComboBox x:Name="StrategyComboBox">
                  <ComboBox.ItemTemplate>
                    <DataTemplate>
                      <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{Binding Name}" />
                        <TextBlock Text="●" Foreground="{Binding HealthBrush}" Visibility="{Binding HealthVisibility}" Margin="8,0,0,0" />
                      </StackPanel>
                    </DataTemplate>
                  </ComboBox.ItemTemplate>
                </ComboBox>
                <WrapPanel Margin="0,16,0,0">
                  <Button x:Name="StartStrategyButton" Content="Запустить стратегию" Background="{StaticResource AccentBrush}" Foreground="#07151A"
                          BorderBrush="{StaticResource AccentBrush}" Click="StartStrategy_Click" />
                  <Button x:Name="StopStrategyButton" Content="Остановить ручной запуск" Click="StopStrategy_Click" Margin="8,0,0,0" />
                  <Button x:Name="InstallServiceButton" Content="Установить службу" Click="InstallService_Click" Margin="8,0,0,0" />
                  <Button x:Name="StartServiceButton" Content="Запустить службу" Click="StartService_Click" Margin="8,0,0,0" />
                  <Button x:Name="StopServiceButton" Content="Остановить службу" Click="StopService_Click" Margin="8,0,0,0" />
                  <Button x:Name="RemoveServiceButton" Content="Удалить службу" Click="RemoveService_Click" Margin="8,0,0,0" />
                  <Button Content="Обновить статус" Click="RefreshServiceStatus_Click" Margin="8,0,0,0" />
                </WrapPanel>
                <TextBlock x:Name="ServiceStatusText" Text="Служба zapret: статус не проверен" Foreground="{StaticResource MutedBrush}" FontSize="13" TextWrapping="Wrap" Margin="1,12,0,0" />
                <TextBlock x:Name="ZapretHealthStatusText" Text="Проверка активной стратегии ещё не выполнялась." Foreground="{StaticResource MutedBrush}" FontSize="13" TextWrapping="Wrap" Margin="1,6,0,0" />
                <Button x:Name="CheckActiveStrategyButton" Content="Проверить активную стратегию" Click="CheckActiveStrategy_Click" HorizontalAlignment="Left" Margin="0,10,0,0" />
              </StackPanel>
            </Border>

            <Border Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="16" Padding="20" Margin="0,14,0,0">
              <StackPanel>
                <TextBlock Text="Параметры пакета" FontSize="17" FontWeight="SemiBold" />
                <Grid Margin="0,12,0,0">
                  <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                  </Grid.RowDefinitions>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="120" />
                    <ColumnDefinition Width="180" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="*" />
                  </Grid.ColumnDefinitions>
                  <TextBlock Text="Игровой фильтр" VerticalAlignment="Center" Foreground="{StaticResource MutedBrush}" />
                  <ComboBox x:Name="GameFilterModeComboBox" Grid.Column="1" />
                  <TextBlock Grid.Row="0" Grid.Column="3" Text="TCP порты" VerticalAlignment="Center" Foreground="{StaticResource MutedBrush}" />
                  <TextBox x:Name="GameFilterTcpTextBox" Grid.Row="1" Grid.Column="3" Margin="0,5,0,0" ToolTip="Например: 1024-65535" />
                  <TextBlock Grid.Row="0" Grid.Column="5" Text="UDP порты" VerticalAlignment="Center" Foreground="{StaticResource MutedBrush}" />
                  <TextBox x:Name="GameFilterUdpTextBox" Grid.Row="1" Grid.Column="5" Margin="0,5,0,0" ToolTip="Например: 1024-65535" />
                </Grid>
                <Grid Margin="0,12,0,0">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="120" />
                    <ColumnDefinition Width="180" />
                    <ColumnDefinition Width="20" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                  </Grid.ColumnDefinitions>
                  <TextBlock Text="IPSet-фильтр" VerticalAlignment="Center" Foreground="{StaticResource MutedBrush}" />
                  <ComboBox x:Name="IpSetModeComboBox" Grid.Column="1" />
                  <CheckBox x:Name="AutoUpdateCheckBox" Grid.Column="3" Content="Проверять релиз в NetShift перед запуском" VerticalAlignment="Center" />
                </Grid>
                <WrapPanel Margin="0,14,0,0">
                  <Button x:Name="SavePackageSettingsButton" Content="Сохранить параметры" Click="SavePackageSettings_Click" />
                  <Button Content="Обновить IPSet" Click="UpdateIpSet_Click" Margin="8,0,0,0" />
                  <Button Content="Проверить новую версию" Click="CheckRelease_Click" Margin="8,0,0,0" />
                </WrapPanel>
              </StackPanel>
            </Border>

            <Border Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="16" Padding="20" Margin="0,14,0,0">
              <StackPanel>
                <TextBlock Text="Инструменты и диагностика" FontSize="17" FontWeight="SemiBold" />
                <Grid Margin="0,12,0,0">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="150" />
                    <ColumnDefinition Width="180" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <ComboBox x:Name="FakeTargetComboBox" Grid.Column="0" />
                  <ComboBox x:Name="FakeFileComboBox" Grid.Column="1" />
                  <TextBlock Grid.Column="3" Text="Замена активного UDP fake-файла" VerticalAlignment="Center" Foreground="{StaticResource MutedBrush}" />
                  <Button Grid.Column="4" Content="Заменить" Click="ReplaceFake_Click" Margin="8,0,0,0" />
                </Grid>
                <WrapPanel Margin="0,14,0,0">
                  <Button Content="Запустить диагностику" Click="RunDiagnostics_Click" />
                  <Button Content="Запустить тесты zapret" Click="RunUpstreamTests_Click" Margin="8,0,0,0" />
                  <Button Content="Проверить hosts" Click="CheckHosts_Click" Margin="8,0,0,0" />
                  <Button Content="Восстановить hosts" Click="RestoreHostsBackup_Click" Margin="8,0,0,0" />
                </WrapPanel>
                <TextBox x:Name="ToolsOutputTextBox" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                         MinHeight="70" MaxHeight="150" Margin="0,12,0,0" />
                <TextBlock Text="Тесты проверяют доступность сетевых адресов."
                           Foreground="{StaticResource MutedBrush}" FontSize="13" TextWrapping="Wrap" Margin="1,8,0,0" />
              </StackPanel>
            </Border>
          </StackPanel>
        </ScrollViewer>
      </Grid>
    </Grid>
  </Grid>
</Window>
