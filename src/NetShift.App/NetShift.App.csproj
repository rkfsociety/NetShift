<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>NetShift.App</RootNamespace>
    <AssemblyName>NetShift</AssemblyName>
    <Version>0.3.0</Version>
  </PropertyGroup>
  <ItemGroup Condition="'$(NetShiftUpdateRepository)' != ''">
    <AssemblyMetadata Include="NetShiftUpdateRepository" Value="$(NetShiftUpdateRepository)" />
  </ItemGroup>
</Project>
