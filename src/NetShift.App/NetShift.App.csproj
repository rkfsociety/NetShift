<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>NetShift.App</RootNamespace>
    <AssemblyName>NetShift</AssemblyName>
    <Version>0.3.030</Version>
    <ApplicationIcon>Assets\NetShift.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup Condition="'$(NetShiftUpdateRepository)' != ''">
    <AssemblyMetadata Include="NetShiftUpdateRepository" Value="$(NetShiftUpdateRepository)" />
  </ItemGroup>
  <ItemGroup>
    <Resource Include="Assets\NetShift.ico" />
    <Resource Include="Assets\NetShift.png" />
  </ItemGroup>
  <ItemGroup Condition="'$(NetShiftDnsServicePath)' != '' and Exists('$(NetShiftDnsServicePath)')">
    <EmbeddedResource Include="$(NetShiftDnsServicePath)" LogicalName="NetShift.App.Payload.NetShift.DnsService.exe" />
    <AssemblyMetadata Include="NetShiftDnsServiceVersion" Value="$(NetShiftDnsServiceVersion)" />
  </ItemGroup>
</Project>
