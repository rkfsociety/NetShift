<Window x:Class="NetShift.App.ThemedMessageDialogWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="NetShift" Width="520" MinWidth="420" MaxWidth="580" MaxHeight="480"
        SizeToContent="Height" WindowStartupLocation="CenterOwner" WindowStyle="None"
        ResizeMode="NoResize" AllowsTransparency="True" Background="Transparent"
        ShowInTaskbar="False" PreviewKeyDown="Window_PreviewKeyDown">
  <Border Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}"
          BorderThickness="1" CornerRadius="12" Padding="1">
    <Border.Effect>
      <DropShadowEffect Color="#000000" BlurRadius="24" ShadowDepth="7" Opacity="0.42" />
    </Border.Effect>
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="42" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>

      <Border Grid.Row="0" Background="{StaticResource SidebarBrush}" CornerRadius="11,11,0,0"
              MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
        <DockPanel LastChildFill="True">
          <Button DockPanel.Dock="Right" Style="{StaticResource WindowCloseButtonStyle}"
                  Click="CloseButton_Click" ToolTip="Закрыть">
            <TextBlock Text="&#xE8BB;" FontFamily="Segoe MDL2 Assets" FontSize="12" />
          </Button>
          <TextBlock x:Name="CaptionText" Margin="16,0,8,0" VerticalAlignment="Center"
                     FontSize="13" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
        </DockPanel>
      </Border>

      <Grid Grid.Row="1" Margin="24,22,24,20">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Border x:Name="IconContainer" Width="44" Height="44" Margin="0,1,18,0"
                CornerRadius="22" BorderThickness="1" VerticalAlignment="Top">
          <TextBlock x:Name="IconGlyph" FontSize="25" FontWeight="SemiBold"
                     HorizontalAlignment="Center" VerticalAlignment="Center" />
        </Border>
        <ScrollViewer Grid.Column="1" MaxHeight="300" VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
          <TextBlock x:Name="MessageText" FontSize="14" TextWrapping="Wrap" LineHeight="20"
                     VerticalAlignment="Center" />
        </ScrollViewer>
      </Grid>

      <StackPanel x:Name="ButtonsPanel" Grid.Row="2" Orientation="Horizontal"
                  HorizontalAlignment="Right" Margin="18,0,18,18" />
    </Grid>
  </Border>
</Window>
