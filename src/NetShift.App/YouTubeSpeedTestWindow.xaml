<Window x:Class="NetShift.App.YouTubeSpeedTestWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Проверка YouTube" Width="680" Height="430" MinWidth="680" MinHeight="430"
        ResizeMode="NoResize" WindowStartupLocation="CenterOwner" ShowInTaskbar="False" ShowActivated="False"
        Background="{StaticResource CanvasBrush}" Foreground="{StaticResource TextBrush}">
  <Grid Margin="12">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>
    <StackPanel Margin="4,0,4,8">
      <TextBlock Text="Тест скорости YouTube · звук отключён" FontSize="15" FontWeight="SemiBold"
                 Foreground="{StaticResource AccentBrush}" />
      <TextBlock x:Name="StatusText" Text="Подготовка беззвучного видеопотока…" FontSize="12"
                 Foreground="{StaticResource MutedBrush}" Margin="0,4,0,0" />
    </StackPanel>
    <Border Grid.Row="1" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
            Background="#000000" CornerRadius="3">
      <Grid x:Name="BrowserHost" ClipToBounds="True" />
    </Border>
  </Grid>
</Window>
